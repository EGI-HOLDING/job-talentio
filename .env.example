# Copy to .env and apps as needed. Local-first defaults.

NODE_ENV=development

# Database
DATABASE_URL=postgresql://talentio:talentio@localhost:5434/job_talentio?schema=public

# Redis
REDIS_URL=redis://localhost:6381

# Meilisearch (typo-tolerant job search; optional - Prisma fallback when unset)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=local-dev-meili-key

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
JWT_SECRET=local-dev-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Payments (mock provider). Webhook signature secret for /api/billing/webhooks/mock.
PAYMENTS_WEBHOOK_SECRET=local-dev-webhook-secret

# OpenAI (CV LLM parse + optional machine translation). Never commit real keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Machine translation fallback for job descriptions with no human version.
# `none` (default) keeps the feature off and free. `openai` and `google`
# support Uzbek; `deepl` does not (ru/en only).
TRANSLATION_PROVIDER=none
# For google/deepl: TRANSLATION_API_KEY=
# For openai: uses OPENAI_API_KEY (TRANSLATION_API_KEY accepted as fallback).
# Monthly character cap enforced in Redis; translation stops when exceeded.
# Failed provider calls refund reserved characters.
# TRANSLATION_MONTHLY_CHAR_BUDGET=200000

# Super Admin bootstrap (seeded on startup)
SUPERADMIN_EMAIL=sarvar.adminov@jobtalentio.uz
SUPERADMIN_PASSWORD=Admin123!

# Dev auth (MUST be false on Railway staging/production)
DEV_AUTH_ENABLED=true

# Object storage — local: MinIO. Cloud: Cloudflare R2 (S3-compatible)
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=job-talentio-prod
#   S3_PUBLIC_URL=https://cdn.jobtalent.io
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=job-talentio
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/job-talentio

# Email — local: Mailpit (secure=false).
# Railway Free/Hobby/Trial BLOCK outbound SMTP — use Resend SDK instead:
#   1. https://resend.com → API key → RESEND_API_KEY=re_... (never commit)
#   2. Until domain verified: SMTP_FROM="Job Talentio <onboarding@resend.dev>"
#   3. After verifying jobtalent.io: SMTP_FROM="Job Talentio <info@jobtalent.io>"
# Hostinger SMTP only works on Railway Pro+ (or local).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Job Talentio <noreply@jobtalentio.local>"
RESEND_API_KEY=

# CV parse (async worker). Provider: local | affinda | llm
# `llm` = OpenAI structures the CV (local text extract + local fallback).
# Requires OPENAI_API_KEY. Text extract never sends PDF bytes to OpenAI.
CV_PARSE_PROVIDER=local
CV_PARSE_OCR=true
# Tesseract langs for thin/scanned PDFs
CV_PARSE_OCR_LANGS=eng+rus

# Payment
PAYMENT_PROVIDER=mock

# Google Sign-In (Web OAuth client from Google Cloud Console; empty = button hidden)
# API verifies the ID token against GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Job Talentio
# Same value as GOOGLE_CLIENT_ID — shows the "Continue with Google" button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Same value as TELEGRAM_BOT_USERNAME — shows the Telegram Login Widget
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Copy to .env and apps as needed. Local-first defaults.

NODE_ENV=development

# Database
DATABASE_URL=postgresql://talentio:talentio@localhost:5434/job_talentio?schema=public

# Redis
REDIS_URL=redis://localhost:6381

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
JWT_SECRET=local-dev-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# Super Admin bootstrap (seeded on startup)
SUPERADMIN_EMAIL=sarvar.adminov@jobtalentio.uz
SUPERADMIN_PASSWORD=Admin123!

# Dev auth (MUST be false on Railway staging/production)
DEV_AUTH_ENABLED=true

# Object storage — local: MinIO. Cloud: Cloudflare R2 (S3-compatible)
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=job-talentio-prod
#   S3_PUBLIC_URL=https://cdn.jobtalent.io
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=job-talentio
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/job-talentio

# Email — local: Mailpit (secure=false). Cloud: Hostinger SMTP
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=noreply@jobtalent.io
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Job Talentio <noreply@jobtalentio.local>"

# Payment
PAYMENT_PROVIDER=mock

# Optional OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Job Talentio

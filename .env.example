# Copy to .env and apps as needed. Local-first defaults.

NODE_ENV=development

# Database
DATABASE_URL=postgresql://talentio:talentio@localhost:5434/job_talentio?schema=public

# Redis
REDIS_URL=redis://localhost:6381

# Meilisearch (typo-tolerant job search; optional - Prisma fallback when unset)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=local-dev-meili-key

# API
API_PORT=4000
# Additional employee promotion slots; enable only after local validation.
EMPLOYEE_BOOST_PLACEMENTS_ENABLED=false
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Privacy jurisdiction is selected per web image: id for Indonesia VPS, uz for Railway/default.
NEXT_PUBLIC_PRIVACY_MARKET=uz
JWT_SECRET=local-dev-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d


# OpenAI (optional machine translation only; never used for CV parsing). Never commit real keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Machine translation fallback for job descriptions with no human version.
# `none` (default) keeps the feature off and free. `openai` and `google`
# support Uzbek; `deepl` does not (ru/en only).
TRANSLATION_PROVIDER=none
# For google/deepl: TRANSLATION_API_KEY=
# For openai: uses OPENAI_API_KEY (TRANSLATION_API_KEY accepted as fallback).
# Monthly character cap enforced in Redis; translation stops when exceeded.
# Failed provider calls refund reserved characters.
# TRANSLATION_MONTHLY_CHAR_BUDGET=200000

# Super Admin bootstrap (seeded on startup)
SUPERADMIN_EMAIL=sarvar.adminov@jobtalentio.uz
SUPERADMIN_PASSWORD=Admin123!

# Dev auth (MUST be false on Railway staging/production)
DEV_AUTH_ENABLED=true

# Object storage — local: MinIO. Cloud: Cloudflare R2 (S3-compatible)
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=job-talentio-prod
#   S3_PUBLIC_URL=https://cdn.jobtalent.io
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=job-talentio
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/job-talentio

# Email — local: Mailpit (secure=false).
# Railway Free/Hobby/Trial BLOCK outbound SMTP — use Resend SDK instead:
#   1. https://resend.com → API key → RESEND_API_KEY=re_... (never commit)
#   2. Until domain verified: SMTP_FROM="Job Talentio <onboarding@resend.dev>"
#   3. After verifying jobtalent.io: SMTP_FROM="Job Talentio <info@jobtalent.io>"
# Hostinger SMTP only works on Railway Pro+ (or local).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Job Talentio <noreply@jobtalentio.local>"
RESEND_API_KEY=

# CV parse is locked to local text extraction and Tesseract OCR (no paid API).
# Legacy CV_PARSE_PROVIDER values are ignored by the application.
CV_PARSE_PROVIDER=local
CV_PARSE_OCR=true
# Tesseract langs for thin/scanned PDFs
CV_PARSE_OCR_LANGS=eng+rus


# Google Sign-In (Web OAuth client from Google Cloud Console; empty = unavailable).
# Public client configuration is read from the API at runtime, including on local builds.
# API verifies the ID token against GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Development only: receive local phone sign-ins without changing a public webhook.
# Requires a local DB and a dedicated bot with no webhook or other polling process.
TELEGRAM_DEV_POLLING=false
# Optional. When set, Telegram must send it as X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Optional public channel (@name or -100... id) that gets a card for every first
# publish. The bot must be a channel admin with permission to post.
TELEGRAM_CHANNEL_ID=

# LinkedIn personal-profile sharing (API server only; disabled until real access is verified).
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_VERIFIED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=202610
# JSON map of version -> independent 32-byte base64 encryption key. Never use JWT_SECRET.
LINKEDIN_TOKEN_KEYS=
LINKEDIN_TOKEN_KEY_VERSION=v1
# Optional internal safety ceilings, per endpoint and UTC day. Not LinkedIn's actual quotas.
# Endpoints: imageInitialize, imageUpload, imageRead, posts. Defaults: app=10000, member=100.
LINKEDIN_ENDPOINT_LIMITS={}

# Phone sign-in. The Telegram contact route needs only the bot above. SMS codes
# need an operator account: SMS_PROVIDER=eskiz with ESKIZ_EMAIL/ESKIZ_PASSWORD
# (Eskiz.uz, legal entity required). `mock` logs the code and is refused on
# public hosts unless SMS_MOCK_ALLOW_PUBLIC=1.
SMS_PROVIDER=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Frontend
## Employee ranking rollout (0 restores legacy ordering; insights remain score-free).
EMPLOYEE_MATCHING_V2_PERCENT=100
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Job Talentio
# Legacy public values; login now reads Google/Telegram availability from the API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Same value as TELEGRAM_BOT_USERNAME — shows the Telegram Login Widget
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Explicitly opt in only on a loopback database and website. Never enable on a deployed environment.
CHECKOUT_TEST_MODE=false
# Catalog synchronization: staging only, activated explicitly during operations.
# database preserves imported catalogs across restarts; legacy keeps old startup behavior.
CATALOG_SOURCE_MODE=legacy
# Maintenance serves /api/health only and boots no application workers/providers.
CATALOG_SYNC_MAINTENANCE=false

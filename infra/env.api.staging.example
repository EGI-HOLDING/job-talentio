# Copy these into Railway → service "api" → Variables (staging).
# Do NOT commit real secrets. Prefer Railway variable references for DB/Redis.

# --- From Railway plugins (use "Add reference", not paste) ---
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}

NODE_ENV=production
DEV_AUTH_ENABLED=false

# Client IP resolution behind proxies: 1 = Railway edge only, 2 = Cloudflare + Railway.
# Custom domains are proxied by Cloudflare, so staging/production use 2.
TRUST_PROXY_HOPS=2
# Redis rate limit for search endpoints (requests per minute per IP; default 60)
# SEARCH_RATE_LIMIT_PER_MIN=60

JWT_SECRET=replace-with-long-random-staging-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Use custom domains once DNS is ready; otherwise use each service's *.up.railway.app URL.
WEB_URL=https://staging.jobtalent.io
ADMIN_URL=https://admin-staging.jobtalent.io
API_URL=https://api-staging.jobtalent.io

SUPERADMIN_EMAIL=admin@jobtalent.io
SUPERADMIN_PASSWORD=replace-with-strong-password

PAYMENT_PROVIDER=mock
# HMAC secret for POST /api/billing/webhooks/mock (X-Mock-Signature).
# Required for webhook-driven payment confirmation; never commit a real value.
PAYMENTS_WEBHOOK_SECRET=replace-with-long-random-webhook-secret

# OpenAI — set in Railway only (never commit). Used by CV_PARSE_PROVIDER=llm
# and TRANSLATION_PROVIDER=openai.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Machine translation fallback (readers can translate a posting that has no
# human version in their language). `none` keeps it off and free; results are
# cached in the translation tables so each text is paid for once.
# `openai` and `google` support Uzbek; `deepl` is ru/en only.
TRANSLATION_PROVIDER=none
# TRANSLATION_API_KEY=replace-with-provider-key  # google/deepl; openai uses OPENAI_API_KEY
# Monthly character cap, enforced in Redis. Requires REDIS_URL: without Redis
# the budget cannot be tracked, so translation stays off. Failed calls refund.
# TRANSLATION_MONTHLY_CHAR_BUDGET=200000

# Staging storage = MinIO on Railway (private S3 API). Production later → R2.
# S3_ENDPOINT=http://minio-staging.railway.internal:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=${{minio-staging.MINIO_ROOT_USER}}
# S3_SECRET_KEY=${{minio-staging.MINIO_ROOT_PASSWORD}}
# S3_BUCKET=job-talentio-staging
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://minio-staging-staging-ba96.up.railway.app/job-talentio-staging

# Platform email From address (used by Resend and SMTP)
# Until jobtalent.io is verified in Resend, use onboarding@resend.dev (test only).
# After Domains → verify jobtalent.io, switch to info@jobtalent.io.
SMTP_FROM="Job Talentio <onboarding@resend.dev>"
# SMTP_FROM="Job Talentio <info@jobtalent.io>"

# REQUIRED on Railway Hobby/Trial: Resend SDK (SMTP is blocked by Railway).
# Create key at https://resend.com/api-keys — set in Railway only, never commit.
# RESEND_API_KEY=re_xxxxxxxx

# Optional Hostinger SMTP — only works on Railway Pro+ (or local Mailpit)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@jobtalent.io
# SMTP_PASS=

# CV parse — `llm` needs OPENAI_API_KEY (local extract + OpenAI structure + local fallback)
# CV_PARSE_PROVIDER=llm
# CV_PARSE_OCR=true
# CV_PARSE_OCR_LANGS=eng+rus

# Meilisearch (Railway service "meilisearch", image getmeili/meilisearch:v1.13).
# Optional: without it, job search silently falls back to Postgres contains
# (no typo tolerance). The meilisearch service MUST set
# MEILI_MAX_INDEXING_MEMORY=1GiB and MEILI_MAX_INDEXING_THREADS=2 (Meili sizes
# memory from the host, not the cgroup -> OOM crash loop on first write
# otherwise), plus MEILI_DB_PATH=/data/data.ms with a volume at /data.
# MEILI_HOST=http://meilisearch.railway.internal:7700
# MEILI_MASTER_KEY=${{meilisearch.MEILI_MASTER_KEY}}

# Google Sign-In (create a Web OAuth client in Google Cloud Console;
# authorized JavaScript origin: https://staging.jobtalent.io)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

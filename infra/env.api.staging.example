# Copy these into Railway → service "api" → Variables (staging).
# Do NOT commit real secrets. Prefer Railway variable references for DB/Redis.

# --- From Railway plugins (use "Add reference", not paste) ---
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}

NODE_ENV=production
DEV_AUTH_ENABLED=false

JWT_SECRET=replace-with-long-random-staging-secret
JWT_EXPIRES_IN=7d

# Use custom domains once DNS is ready; otherwise use each service's *.up.railway.app URL.
WEB_URL=https://staging.jobtalent.io
ADMIN_URL=https://admin-staging.jobtalent.io
API_URL=https://api-staging.jobtalent.io

SUPERADMIN_EMAIL=admin@jobtalent.io
SUPERADMIN_PASSWORD=replace-with-strong-password

PAYMENT_PROVIDER=mock

# Staging storage = MinIO on Railway (private S3 API). Production later → R2.
# S3_ENDPOINT=http://minio-staging.railway.internal:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=${{minio-staging.MINIO_ROOT_USER}}
# S3_SECRET_KEY=${{minio-staging.MINIO_ROOT_PASSWORD}}
# S3_BUCKET=job-talentio-staging
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://minio-staging-staging-ba96.up.railway.app/job-talentio-staging

# Platform email From address (used by Resend and SMTP)
# Until jobtalent.io is verified in Resend, use onboarding@resend.dev (test only).
# After Domains → verify jobtalent.io, switch to info@jobtalent.io.
SMTP_FROM="Job Talentio <onboarding@resend.dev>"
# SMTP_FROM="Job Talentio <info@jobtalent.io>"

# REQUIRED on Railway Hobby/Trial: Resend SDK (SMTP is blocked by Railway).
# Create key at https://resend.com/api-keys — set in Railway only, never commit.
# RESEND_API_KEY=re_xxxxxxxx

# Optional Hostinger SMTP — only works on Railway Pro+ (or local Mailpit)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@jobtalent.io
# SMTP_PASS=

# CV parse (defaults are fine; override only if needed)
# CV_PARSE_PROVIDER=local
# CV_PARSE_OCR=true
# CV_PARSE_OCR_LANGS=eng+rus

# Google Sign-In (create a Web OAuth client in Google Cloud Console;
# authorized JavaScript origin: https://staging.jobtalent.io)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

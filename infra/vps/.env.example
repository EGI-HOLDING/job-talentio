RELEASE_ID=replace-with-git-commit
TALENTIO_ENV_FILE=/var/www/talentio/shared/.env
NODE_ENV=production
APP_ENV=production
DEPLOYMENT_TARGET=indonesia-vps
APP_DEFAULT_LOCALE=id
PORT=4000
DATABASE_URL=postgresql://talentio_app:replace-with-random-password@host.docker.internal:5432/talentio?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_URL=https://cari-kerja.co.id
API_URL=https://api.cari-kerja.co.id
ADMIN_URL=https://su-stage.cari-kerja.co.id
TRUST_PROXY_HOPS=1
DEV_AUTH_ENABLED=false
CATALOG_SOURCE_MODE=database
CATALOG_SYNC_MAINTENANCE=false
REDIS_URL=redis://redis:6379
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=replace-with-random-secret
S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-random-access-key
S3_SECRET_KEY=replace-with-random-secret-key
S3_BUCKET=talentio
S3_PUBLIC_URL=https://api.cari-kerja.co.id/talentio
S3_FORCE_PATH_STYLE=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
CV_PARSE_PROVIDER=local
CV_PARSE_OCR=true
CV_PARSE_OCR_LANGS=eng+ind+rus
TRANSLATION_PROVIDER=none
CHECKOUT_TEST_MODE=false
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_VERIFIED=false
# Intentionally omit SUPERADMIN_PASSWORD: the initial database has no users.

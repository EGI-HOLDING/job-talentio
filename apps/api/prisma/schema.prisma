generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  RECRUITER
  SUPER_ADMIN
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER
}

enum PlanCode {
  FREE
  STANDARD
  PREMIUM
  VIP
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  EXPIRED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  NEW
  IN_REVIEW
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ResumeParseStatus {
  NONE
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ProfileVisibility {
  PUBLIC
  TO_REGISTERED_RECRUITERS
  PRIVATE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

enum AlertFrequency {
  DAILY
  WEEKLY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  MOCKED
}

enum DegreeLevel {
  HIGH_SCHOOL
  VOCATIONAL
  BACHELOR
  MASTER
  PHD
}

enum ExperienceLevel {
  INTERN
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
  EXECUTIVE
}

enum SalaryPeriod {
  MONTHLY
  YEARLY
  HOURLY
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1000_PLUS
}

enum NotificationType {
  APPLICATION_STATUS
  NEW_APPLICANT
  INTERVIEW_SCHEDULED
  NEW_JOB_MATCH
  CHAT_MESSAGE
  SYSTEM
}

enum QuestionType {
  TEXT
  YES_NO
  NUMBER
}

enum BulkDeliveryStatus {
  PENDING
  SENT
  SKIPPED_OPTED_OUT
  FAILED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReportEntityType {
  JOB_POST
  USER
  COMPANY
  CHAT_MESSAGE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ProvinceType {
  REGION
  CITY
  REPUBLIC
}

/// Translation state of a catalog label that users can create at runtime.
/// IGNORED marks tech or brand identities (React, C++) that read the same in
/// every language, so they never clutter the admin queue.
enum CatalogI18nStatus {
  PENDING
  COMPLETE
  IGNORED
}

// ─── Lookup tables ───────────────────────────────────────────

/// Catalog lifecycle columns, present on every admin-managed lookup table:
///
/// `archivedAt` hides a row from suggestions, lists and facet options while the
/// profiles and postings already pointing at it keep rendering. A row with no
/// usages is hard deleted instead of archived.
///
/// `curatedAt` records that an admin edited the row by hand. Deploy backfills
/// re-run on every container start and would otherwise rewrite the name back to
/// the seed catalog, so they skip curated rows.
model Skill {
  id              String            @id @default(cuid())
  name            String
  nameUz          String?
  nameRu          String?
  nameUzIsMachine Boolean           @default(false)
  nameRuIsMachine Boolean           @default(false)
  i18nStatus      CatalogI18nStatus @default(PENDING)
  slug            String            @unique
  normalizedKey   String?           @unique
  category        String?
  archivedAt      DateTime?
  curatedAt       DateTime?
  createdAt       DateTime          @default(now())

  aliases        SkillAlias[]
  profileSkills  ProfileSkill[]
  jobPostSkills  JobPostSkill[]
  jobAlertSkills JobAlertSkill[]

  @@index([i18nStatus, createdAt])
  @@index([archivedAt])
}

model SkillAlias {
  id        String   @id @default(cuid())
  skillId   String
  alias     String
  aliasKey  String   @unique
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model Country {
  id           String    @id @default(cuid())
  name         String
  nameUz       String?
  nameRu       String?
  slug         String    @unique
  iso2         String    @unique @db.Char(2)
  iso3         String    @db.Char(3)
  phoneCode    String
  currencyCode String?
  /// Whether the market is live. Separate from archivedAt, which is catalog visibility.
  isActive     Boolean   @default(true)
  archivedAt   DateTime?
  curatedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  provinces Province[]

  @@index([archivedAt])
}

model Province {
  id         String       @id @default(cuid())
  countryId  String
  name       String
  nameUz     String?
  nameRu     String?
  slug       String
  type       ProvinceType @default(REGION)
  archivedAt DateTime?
  curatedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities  City[]

  @@unique([countryId, slug])
  @@index([countryId])
  @@index([archivedAt])
}

model City {
  id         String    @id @default(cuid())
  name       String
  nameUz     String?
  nameRu     String?
  slug       String    @unique
  provinceId String
  archivedAt DateTime?
  curatedAt  DateTime?

  province        Province          @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  jobPosts        JobPost[]
  profiles        EmployeeProfile[]
  companies       Company[]
  jobAlerts       JobAlert[]
  workExperiences WorkExperience[]

  @@index([provinceId])
  @@index([archivedAt])
}

model JobCategory {
  id         String    @id @default(cuid())
  name       String
  nameUz     String?
  nameRu     String?
  slug       String    @unique
  icon       String?
  archivedAt DateTime?
  curatedAt  DateTime?

  jobPosts  JobPost[]
  jobAlerts JobAlert[]

  @@index([archivedAt])
}

model IndustryGroup {
  id         String    @id @default(cuid())
  name       String
  nameUz     String?
  nameRu     String?
  slug       String    @unique
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  curatedAt  DateTime?

  industries Industry[]

  @@index([archivedAt])
}

model Industry {
  id         String    @id @default(cuid())
  name       String
  nameUz     String?
  nameRu     String?
  slug       String    @unique
  sortOrder  Int       @default(0)
  groupId    String
  archivedAt DateTime?
  curatedAt  DateTime?

  group     IndustryGroup @relation(fields: [groupId], references: [id])
  companies Company[]

  @@index([groupId])
  @@index([archivedAt])
}

model Language {
  id              String            @id @default(cuid())
  name            String
  nameUz          String?
  nameRu          String?
  nameUzIsMachine Boolean           @default(false)
  nameRuIsMachine Boolean           @default(false)
  i18nStatus      CatalogI18nStatus @default(PENDING)
  code            String            @unique
  normalizedKey   String?           @unique
  archivedAt      DateTime?
  curatedAt       DateTime?
  createdAt       DateTime          @default(now())

  aliases          LanguageAlias[]
  profileLanguages ProfileLanguage[]
  jobLanguages     JobPostLanguage[]

  @@index([i18nStatus, createdAt])
  @@index([archivedAt])
}

model LanguageAlias {
  id         String   @id @default(cuid())
  languageId String
  alias      String
  aliasKey   String   @unique
  createdAt  DateTime @default(now())

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@index([languageId])
}

model Benefit {
  id              String            @id @default(cuid())
  name            String
  nameUz          String?
  nameRu          String?
  nameUzIsMachine Boolean           @default(false)
  nameRuIsMachine Boolean           @default(false)
  i18nStatus      CatalogI18nStatus @default(PENDING)
  slug            String            @unique
  normalizedKey   String?           @unique
  icon            String?
  archivedAt      DateTime?
  curatedAt       DateTime?
  createdAt       DateTime          @default(now())

  aliases         BenefitAlias[]
  jobPostBenefits JobPostBenefit[]

  @@index([i18nStatus, createdAt])
  @@index([archivedAt])
}

model BenefitAlias {
  id        String   @id @default(cuid())
  benefitId String
  alias     String
  aliasKey  String   @unique
  createdAt DateTime @default(now())

  benefit Benefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@index([benefitId])
}

/// Canonical role title (no seniority — use JobPost.experienceLevel).
model JobTitle {
  id              String            @id @default(cuid())
  name            String
  nameUz          String?
  nameRu          String?
  nameUzIsMachine Boolean           @default(false)
  nameRuIsMachine Boolean           @default(false)
  i18nStatus      CatalogI18nStatus @default(PENDING)
  slug            String            @unique
  normalizedKey   String            @unique
  archivedAt      DateTime?
  curatedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  aliases  JobTitleAlias[]
  jobPosts JobPost[]
  resumes  Resume[]

  @@index([i18nStatus, createdAt])
  @@index([archivedAt])
}

model JobTitleAlias {
  id         String   @id @default(cuid())
  jobTitleId String
  alias      String
  aliasKey   String   @unique
  createdAt  DateTime @default(now())

  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)

  @@index([jobTitleId])
}

// ─── Core identity ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  fullName      String
  role          UserRole  @default(EMPLOYEE)
  locale        String    @default("uz")
  avatarUrl     String?
  isBanned      Boolean   @default(false)
  emailVerified Boolean   @default(false)
  googleId      String?   @unique
  telegramId    String?   @unique
  /// Cold-read fallback for presence when Redis has no live entry
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employeeProfile         EmployeeProfile?
  memberships             CompanyMember[]
  sentMessages            ChatMessage[]            @relation("SentMessages")
  conversationsAsA        Conversation[]           @relation("ConversationUserA")
  conversationsAsB        Conversation[]           @relation("ConversationUserB")
  auditLogs               AuditLog[]
  jobAlerts               JobAlert[]
  notifications           Notification[]
  followedCompanies       CompanyFollower[]
  jobViews                JobView[]
  reports                 Report[]                 @relation("Reporter")
  messageTemplates        MessageTemplate[]        @relation("TemplateAuthor")
  bulkCampaigns           BulkCampaign[]           @relation("BulkCampaignAuthor")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
  refreshTokens           RefreshToken[]
  companyInvitesSent      CompanyInvite[]          @relation("CompanyInvitesSent")
  telegramLinkTokens      TelegramLinkToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the raw token held by the client — raw token is never stored
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the raw token sent by email — raw token is never stored
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  /// Language `description` is written in; translations live in CompanyTranslation.
  locale      String       @default("uz")
  website     String?
  cityId      String?
  industryId  String?
  size        CompanySize?
  logoUrl     String?
  isVerified  Boolean      @default(false)
  isBanned    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  city             City?                @relation(fields: [cityId], references: [id])
  industry         Industry?            @relation(fields: [industryId], references: [id])
  members          CompanyMember[]
  jobPosts         JobPost[]
  subscription     Subscription?
  payments         Payment[]
  followers        CompanyFollower[]
  messageTemplates MessageTemplate[]
  bulkCampaigns    BulkCampaign[]
  translations     CompanyTranslation[]
  invites          CompanyInvite[]

  @@index([cityId])
  @@index([industryId])
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(RECRUITER)
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

/// Pending team invite. Raw token lives only in the email; we store SHA-256.
model CompanyInvite {
  id          String            @id @default(cuid())
  companyId   String
  email       String
  role        CompanyMemberRole
  /// Language used for the invitation email (uz/ru/en)
  locale      String            @default("uz")
  /// SHA-256 of the raw token sent by email — raw token is never stored
  tokenHash   String            @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("CompanyInvitesSent", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@index([expiresAt])
}

model Subscription {
  id        String             @id @default(cuid())
  companyId String             @unique
  plan      PlanCode           @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String        @id @default(cuid())
  companyId  String
  provider   String        @default("mock")
  externalId String?
  purpose    String
  amountUzs  Int
  currency   String        @default("UZS")
  status     PaymentStatus @default(PENDING)
  metadata   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model JobPost {
  id                 String           @id @default(cuid())
  companyId          String
  jobTitleId         String?
  /// Denormalized display (= JobTitle.name after resolve)
  title              String
  description        String
  cityId             String?
  categoryId         String?
  employmentType     EmploymentType   @default(FULL_TIME)
  workMode           WorkMode         @default(ONSITE)
  salaryMin          Int?
  salaryMax          Int?
  salaryPeriod       SalaryPeriod     @default(MONTHLY)
  currency           String           @default("UZS")
  experienceYearsMin Int?
  experienceLevel    ExperienceLevel?
  locale             String           @default("uz")
  status             JobStatus        @default(DRAFT)
  publishedAt        DateTime?
  closedAt           DateTime?
  boostWeight        Float            @default(0)
  boostUntil         DateTime?
  /// SHA-256 of normalized title|workMode|cityId — blocks duplicate openings
  fingerprint        String?
  /// SHA-256 of normalized description — blocks copy-paste duplicate posts
  contentHash        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobTitle      JobTitle?            @relation(fields: [jobTitleId], references: [id])
  city          City?                @relation(fields: [cityId], references: [id])
  category      JobCategory?         @relation(fields: [categoryId], references: [id])
  jobSkills     JobPostSkill[]
  jobLanguages  JobPostLanguage[]
  benefits      JobPostBenefit[]
  applications  Application[]
  savedBy       SavedJob[]
  questions     JobQuestion[]
  views         JobView[]
  bulkCampaigns BulkCampaign[]
  translations  JobPostTranslation[]

  @@index([companyId, status])
  @@index([status, publishedAt])
  @@index([cityId])
  @@index([categoryId])
  @@index([jobTitleId])
  @@index([experienceLevel])
  @@index([companyId, fingerprint])
  @@index([companyId, contentHash])
}

/// Optional per-language version of a posting. The original language lives on
/// JobPost itself (JobPost.locale); rows here are extra versions, either written
/// by the recruiter or produced by machine translation (isMachine).
model JobPostTranslation {
  id          String   @id @default(cuid())
  jobPostId   String
  locale      String
  title       String
  description String
  isMachine   Boolean  @default(false)
  /// SHA-256 of the source text: lets machine output expire when the original changes.
  sourceHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, locale])
  @@index([jobPostId])
}

model JobPostLanguage {
  id         String        @id @default(cuid())
  jobPostId  String
  languageId String
  minLevel   LanguageLevel @default(B1)
  isRequired Boolean       @default(true)

  jobPost  JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, languageId])
  @@index([languageId])
}

model JobPostSkill {
  id         String  @id @default(cuid())
  jobPostId  String
  skillId    String
  isRequired Boolean @default(true)
  weight     Float   @default(1)

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, skillId])
  @@index([skillId])
}

model JobPostBenefit {
  id        String @id @default(cuid())
  jobPostId String
  benefitId String

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  benefit Benefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, benefitId])
}

model EmployeeProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  headline          String?
  summary           String?
  /// Detected language of the narrative fields, used to pick a translation
  /// and to badge the original when a reader is browsing in another language.
  contentLocale     String?
  cityId            String?
  phone             String?           @unique
  visibility        ProfileVisibility @default(TO_REGISTERED_RECRUITERS)
  desiredSalaryMin  Int?
  desiredPosition   String?
  /// GDPR: opt out of recruiter bulk messaging (pipeline status updates still allowed)
  bulkCommsOptOut   Boolean           @default(false)
  bulkCommsOptOutAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  city           City?                        @relation(fields: [cityId], references: [id])
  skills         ProfileSkill[]
  experiences    WorkExperience[]
  educations     Education[]
  certifications Certification[]
  languages      ProfileLanguage[]
  resumes        Resume[]
  applications   Application[]
  savedJobs      SavedJob[]
  translations   EmployeeProfileTranslation[]

  @@index([cityId])
}

model ProfileSkill {
  id        String     @id @default(cuid())
  profileId String
  skillId   String
  level     SkillLevel @default(INTERMEDIATE)

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([skillId])
}

model WorkExperience {
  id           String    @id @default(cuid())
  profileId    String
  companyName  String
  title        String
  description  String?
  cityId       String?
  locationNote String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)

  profile      EmployeeProfile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  city         City?                       @relation(fields: [cityId], references: [id])
  translations WorkExperienceTranslation[]
}

model Education {
  id        String       @id @default(cuid())
  profileId String
  school    String
  degree    DegreeLevel?
  field     String?
  startDate DateTime?
  endDate   DateTime?

  profile      EmployeeProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  translations EducationTranslation[]

  @@index([school])
  @@index([degree])
}

/// Per-language version of a candidate's headline and about text.
model EmployeeProfileTranslation {
  id         String   @id @default(cuid())
  profileId  String
  locale     String
  headline   String?
  summary    String?
  isMachine  Boolean  @default(false)
  sourceHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale])
  @@index([profileId])
}

/// Per-language version of a work-experience title and description. Company names stay on the parent.
model WorkExperienceTranslation {
  id           String   @id @default(cuid())
  experienceId String
  locale       String
  title        String
  description  String?
  isMachine    Boolean  @default(false)
  sourceHash   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experience WorkExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, locale])
  @@index([experienceId])
}

/// Per-language version of an education field of study. School names stay on the parent.
model EducationTranslation {
  id          String   @id @default(cuid())
  educationId String
  locale      String
  field       String
  isMachine   Boolean  @default(false)
  sourceHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  education Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@unique([educationId, locale])
  @@index([educationId])
}

model Certification {
  id            String    @id @default(cuid())
  profileId     String
  name          String
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfileLanguage {
  id         String        @id @default(cuid())
  profileId  String
  languageId String
  level      LanguageLevel

  profile  EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([profileId, languageId])
}

model Resume {
  id               String            @id @default(cuid())
  profileId        String
  title            String
  /// Canonical target role for matching / analytics (not the free-text display title).
  targetJobTitleId String?
  content          String?
  fileKey          String?
  fileUrl          String?
  isPrimary        Boolean           @default(false)
  parsedData       Json?
  parseStatus      ResumeParseStatus @default(NONE)
  parseError       String?
  parsedAt         DateTime?
  templateKey      String            @default("classic")
  themeAccent      String?
  inclusion        Json?
  builderMeta      Json?
  /**
   * Soft-delete tombstone; hard-purged when no Application references remain.
   */
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  profile        EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetJobTitle JobTitle?       @relation(fields: [targetJobTitleId], references: [id], onDelete: SetNull)
  applications   Application[]

  @@index([profileId])
  @@index([profileId, deletedAt])
  @@index([targetJobTitleId])
  @@index([parseStatus])
}

model Application {
  id             String            @id @default(cuid())
  jobPostId      String
  profileId      String
  resumeId       String?
  status         ApplicationStatus @default(NEW)
  coverLetter    String?
  resumeSnapshot Json?
  matchScore     Float?
  matchBreakdown Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  jobPost    JobPost             @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  profile    EmployeeProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resume     Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  events     PipelineEvent[]
  answers    ApplicationAnswer[]
  interviews Interview[]

  @@unique([jobPostId, profileId])
  @@index([profileId])
  @@index([status])
  @@index([matchScore])
  @@index([resumeId])
}

model PipelineEvent {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  actorUserId   String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model SavedJob {
  id        String   @id @default(cuid())
  profileId String
  jobPostId String
  createdAt DateTime @default(now())

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPost JobPost         @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobPostId])
}

model Conversation {
  id             String   @id @default(cuid())
  userAId        String
  userBId        String
  companyId      String?
  jobPostId      String?
  initiatedBy    String
  isColdOutreach Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userA    User          @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User          @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([userAId, userBId, jobPostId])
  @@index([userAId])
  @@index([userBId])
}

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime  @default(now())
  /// When the peer account received/fetched the message
  deliveredAt    DateTime?
  /// When the peer account opened/read the thread
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model JobAlert {
  id              String         @id @default(cuid())
  userId          String
  name            String
  query           String?
  cityId          String?
  categoryId      String?
  frequency       AlertFrequency @default(DAILY)
  isActive        Boolean        @default(true)
  notifyInApp     Boolean        @default(true)
  notifyEmail     Boolean        @default(true)
  notifyTelegram  Boolean        @default(false)
  lastSentAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City?           @relation(fields: [cityId], references: [id])
  category JobCategory?    @relation(fields: [categoryId], references: [id])
  skills   JobAlertSkill[]

  @@index([userId])
}

model TelegramLinkToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 of the raw start payload — raw token is never stored
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JobAlertSkill {
  id      String @id @default(cuid())
  alertId String
  skillId String

  alert JobAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  skill Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([alertId, skillId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Enterprise features ─────────────────────────────────────

/// `messageKey` + `messageParams` let a notification follow the reader when they
/// switch language. `title`/`body` stay for rows created before that and as the
/// fallback when a key is missing from the dictionary.
model Notification {
  id            String           @id @default(cuid())
  userId        String
  type          NotificationType
  title         String
  body          String?
  messageKey    String?
  messageParams Json?
  linkUrl       String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model JobQuestion {
  id         String       @id @default(cuid())
  jobPostId  String
  question   String
  type       QuestionType @default(TEXT)
  isRequired Boolean      @default(true)
  sortOrder  Int          @default(0)

  jobPost      JobPost                 @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  answers      ApplicationAnswer[]
  translations JobQuestionTranslation[]

  @@index([jobPostId])
}

/// Screening question in another language. The original wording stays on
/// JobQuestion and follows the posting's locale (JobPost.locale).
model JobQuestionTranslation {
  id         String   @id @default(cuid())
  questionId String
  locale     String
  question   String
  isMachine  Boolean  @default(false)
  sourceHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobQuestion JobQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
  @@index([questionId])
}

model ApplicationAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  answer        String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    JobQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  durationMins  Int             @default(60)
  location      String?
  meetingUrl    String?
  note          String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
}

model CompanyFollower {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model JobView {
  id        String   @id @default(cuid())
  jobPostId String
  viewerId  String?
  createdAt DateTime @default(now())

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  viewer  User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([jobPostId, createdAt])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  entityType ReportEntityType
  entityId   String
  reason     String
  status     ReportStatus     @default(OPEN)
  resolution String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([entityType, entityId])
}

// ─── Bulk communication (recruiter) ──────────────────────────

model MessageTemplate {
  id        String   @id @default(cuid())
  companyId String
  createdBy String
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author    User           @relation("TemplateAuthor", fields: [createdBy], references: [id], onDelete: Cascade)
  campaigns BulkCampaign[]

  @@index([companyId, updatedAt])
}

model BulkCampaign {
  id          String             @id @default(cuid())
  companyId   String
  jobPostId   String
  createdById String
  templateId  String?
  messageBody String?
  fromStatus  ApplicationStatus?
  toStatus    ApplicationStatus?
  note        String?
  createdAt   DateTime           @default(now())

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPost    JobPost                 @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  createdBy  User                    @relation("BulkCampaignAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  template   MessageTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients BulkCampaignRecipient[]

  @@index([companyId, createdAt])
  @@index([jobPostId, createdAt])
}

model BulkCampaignRecipient {
  id             String             @id @default(cuid())
  campaignId     String
  applicationId  String
  userId         String
  candidateName  String
  deliveryStatus BulkDeliveryStatus @default(PENDING)
  errorMessage   String?
  conversationId String?
  messageId      String?
  statusMoved    Boolean            @default(false)
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  campaign BulkCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId, createdAt])
  @@index([applicationId])
}

enum NewsCategory {
  CAREER
  INSIGHT
  EVENT
  EDUCATION
}

/// Curated editorial content (career/insight/event/education). Seeded with
/// original summaries plus source attribution - not scraped article bodies.
model NewsArticle {
  id          String       @id @default(cuid())
  slug        String       @unique
  category    NewsCategory
  title       String
  excerpt     String
  /// Plain paragraphs separated by blank lines (rendered as <p> blocks)
  body        String
  coverUrl    String?
  coverCredit String?
  sourceName  String?
  sourceUrl   String?
  locale      String       @default("en")
  publishedAt DateTime
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  translations NewsArticleTranslation[]

  @@index([isPublished, publishedAt])
  @@index([category, publishedAt])
}

/// Per-language version of an article. The slug stays shared so one canonical
/// URL per article keeps its search ranking across languages.
model NewsArticleTranslation {
  id         String   @id @default(cuid())
  articleId  String
  locale     String
  title      String
  excerpt    String
  body       String
  isMachine  Boolean  @default(false)
  sourceHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([articleId])
}

/// Optional localized company description.
model CompanyTranslation {
  id          String   @id @default(cuid())
  companyId   String
  locale      String
  description String
  isMachine   Boolean  @default(false)
  sourceHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, locale])
  @@index([companyId])
}

/// Translation state of a catalog label that users can create at runtime.
/// IGNORED marks tech or brand identities (React, C++) that read the same in
/// every language, so they never clutter the admin queue.
enum CatalogI18nStatus {
  PENDING
  COMPLETE
  IGNORED
}

// ─── Lookup tables ───────────────────────────────────────────

/// Catalog lifecycle columns, present on every admin-managed lookup table:
///
/// `archivedAt` hides a row from suggestions, lists and facet options while the
/// profiles and postings already pointing at it keep rendering. A row with no
/// usages is hard deleted instead of archived.
///
/// `curatedAt` records that an admin edited the row by hand. Deploy backfills
/// re-run on every container start and would otherwise rewrite the name back to
/// the seed catalog, so they skip curated rows.
model Skill {
  matchingKind String @default("UNREVIEWED")
  id              String            @id @default(cuid())
  name            String
  nameUz          String?
  nameRu          String?
  nameId          String?
  nameUzIsMachine Boolean           @default(false)
  nameRuIsMachine Boolean           @default(false)
  nameIdIsMachine Boolean           @default(false)
  i18nStatus      CatalogI18nStatus @default(PENDING)
  slug            String            @unique
  normalizedKey   String?           @unique
  category        String?
  archivedAt      DateTime?
  curatedAt       DateTime?
  createdAt       DateTime          @default(now())

  aliases        SkillAlias[]
  profileSkills  ProfileSkill[]
  jobPostSkills  JobPostSkill[]
  jobAlertSkills JobAlertSkill[]

  @@index([i18nStatus, createdAt])
  @@index([archivedAt])
}

model SkillAlias {
  id        String   @id @default(cuid())
  skillId   String
  alias     String
  aliasKey  String   @unique
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model Country {
  id           String    @id @default(cuid())
  name         String
  nameUz       String?
  nameRu       String?
  nameId       String?
  slug         String    @unique
  iso2         String    @unique @db.Char(2)
  iso3         String    @db.Char(3)
  phoneCode    String
  currencyCode String?
  /// Whether the market is live. Separate from archivedAt, which is catalog visibility.
  isActive     Boolean   @default(true)
  jobAlerts    JobAlert[]
  archivedAt   DateTime?
  curatedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  residentEmployees EmployeeProfile[] @relation("EmployeeResidence")
  preferredByEmployees EmployeeProfile[] @relation("EmployeePreferredCountries")
  employeeExperiences WorkExperience[]
  provinces Province[]
  jobPosts JobPost[]

  @@index([archivedAt])
}

model Province {
  id         String       @id @default(cuid())
  countryId  String
  name       String
  nameUz     String?
  nameRu     String?
  nameId     String?
  slug       String
  sourceCode String?      @unique
  type       ProvinceType @default(REGION)
  archivedAt DateTime?
  curatedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities  City[]

  @@unique([countryId, slug])
  @@index([countryId])
  @@index([archivedAt])
}

model City {
  id         String    @id @default(cuid())
  name       String
  nameUz     String?
  nameRu     String?
  nameId     String?
  slug       String    @unique
  provinceId String
  sourceCode String?   @unique
  /// CITY / REGENCY are selectable; legacy districts remain linked to old data.
  kind       String    @default("CITY")
  archivedAt DateTime?
  curatedAt  DateTime?

  province        Province          @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  jobPosts        JobPost[]
  profiles        EmployeeProfile[]
  companies       Company[]
  jobAlerts       JobAlert[]
  workExperiences WorkExperience[]
  aliases         CityAlias[]

  @@index([provinceId])
  @@index([archivedAt])
}

model CityAlias {
  id        String @id @default(cuid())
  cityId    String
  alias     String
  aliasKey  String
  city      City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, aliasKey])
  @@index([aliasKey])
}

model JobCategory {
  id         String    @id @default(cuid())
  name       String
  nameUz     String?
  nameRu     String?
  nameId     String?
  slug       String    @unique
  icon       String?
  archivedAt DateTime?
  curatedAt  DateTime?

  jobPosts  JobPost[]
  jobAlerts JobAlert[]

  @@index([archivedAt])
}

model IndustryGroup {
  id         String    @id @default(cuid())
  name       String
  nameUz     String?
  nameRu     String?
  nameId     String?
  slug       String    @unique
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  curatedAt  DateTime?

  industries Industry[]

  @@index([archivedAt])
}

model Industry {
  id         String    @id @default(cuid())
  name       String
  nameUz     String?
  nameRu     String?
  nameId     String?
  slug       String    @unique
  sortOrder  Int       @default(0)
  groupId    String
  archivedAt DateTime?
  curatedAt  DateTime?

  group     IndustryGroup @relation(fields: [groupId], references: [id])
  companies Company[]
  businessMappings IndustryGroupMapping[]

  @@index([groupId])
  @@index([archivedAt])
}

/// Additive taxonomy. Legacy IndustryGroup and Industry identities stay intact.
model IndustryTaxonomy {
  version String @id
  active Boolean @default(false)
  createdAt DateTime @default(now())
  groups BusinessIndustryGroup[]
}

model BusinessIndustryGroup {
  classifiedCompanies Company[] @relation("CompanyIndustryGroups")
  id String @id
  code String
  version String
  name String
  nameId String
  nameUz String
  nameRu String
  definition String
  boundaries String
  sortOrder Int
  archivedAt DateTime?
  taxonomy IndustryTaxonomy @relation(fields: [version], references: [version], onDelete: Restrict)
  mappings IndustryGroupMapping[]
  companies Company[]
  @@unique([code, version])
  @@index([version, archivedAt, sortOrder])
}

model IndustryGroupMapping {
  industryId String
  version String
  groupId String
  source String
  reason String
  createdAt DateTime @default(now())
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)
  group BusinessIndustryGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  @@id([industryId, version])
  @@index([groupId])
}

model SeniorityCatalog {

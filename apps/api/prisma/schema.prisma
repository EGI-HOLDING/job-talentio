model BenefitAlias {
  id        String   @id @default(cuid())
  benefitId String
  alias     String
  aliasKey  String   @unique
  createdAt DateTime @default(now())

  benefit Benefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@index([benefitId])
}

/// Canonical role title (no seniority — use JobPost.experienceLevel).
model JobTitle {
  approvedJobGroupScopes JobPositionGroupMember[]
  positionGroupMemberships PositionGroupMembership[]
  positionGroupLabels PositionGroupRoleLabel[]
  positionGroupHeads PositionGroup[]
  familyId String?
  family JobFamily? @relation(fields: [familyId], references: [id], onDelete: Restrict)
  canonicalRoleId String?
  canonicalRole JobTitle? @relation("CanonicalEmployeeRole", fields: [canonicalRoleId], references: [id], onDelete: Restrict)
  equivalentRoles JobTitle[] @relation("CanonicalEmployeeRole")
  matchingApproved Boolean @default(false)
  desiredBy EmployeeDesiredRole[]
  id              String            @id @default(cuid())
  name            String
  nameUz          String?
  nameRu          String?
  nameId          String?
  nameUzIsMachine Boolean           @default(false)
  nameRuIsMachine Boolean           @default(false)
  nameIdIsMachine Boolean           @default(false)
  i18nStatus      CatalogI18nStatus @default(PENDING)
  slug            String            @unique
  normalizedKey   String            @unique
  matchingMetadata Json?
  archivedAt      DateTime?
  curatedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  aliases  JobTitleAlias[]
  jobPosts JobPost[]
  resumes  Resume[]

  @@index([familyId, matchingApproved])
  @@index([canonicalRoleId])

  @@index([i18nStatus, createdAt])
  @@index([archivedAt])
}

model JobTitleAlias {
  matchingApproved Boolean @default(false)
  id         String   @id @default(cuid())
  jobTitleId String
  alias      String
  aliasKey   String   @unique
  createdAt  DateTime @default(now())

  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)

  @@index([jobTitleId])
}

// ─── Core identity ───────────────────────────────────────────

model User {
  candidateMessageBatches CandidateMessageBatch[] @relation("CandidateMessageAuthor")
  receivedScreeningInvitations ScreeningInvitation[] @relation("ScreeningRecipient")
  sentScreeningInvitations ScreeningInvitation[] @relation("ScreeningSender")
  assignedRecruitmentCandidates RecruitmentCandidate[] @relation("CandidateAssignee")
  id            String    @id @default(cuid())
  email         String?   @unique
  passwordHash  String?
  fullName      String
  role          UserRole  @default(EMPLOYEE)
  locale        String    @default("uz")
  avatarUrl     String?
  isBanned      Boolean   @default(false)
  emailVerified Boolean   @default(false)
  googleId      String?   @unique
  telegramId    String?   @unique
  /// Login identity in E.164 (+998...), verified via a Telegram contact share or SMS code.
  phone           String?   @unique @db.VarChar(20)
  phoneVerifiedAt DateTime?
  /// Cold-read fallback for presence when Redis has no live entry
  lastSeenAt    DateTime?
  /// Bumped to invalidate access JWTs (force logout / ban) without a blacklist.
  tokenVersion  Int       @default(0)
  /// Set when support erases identity; the row is kept for FK history.
  anonymizedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employeeProfile         EmployeeProfile?
  memberships             CompanyMember[]
  sentMessages            ChatMessage[]            @relation("SentMessages")
  conversationsAsA        Conversation[]           @relation("ConversationUserA")
  conversationsAsB        Conversation[]           @relation("ConversationUserB")
  auditLogs               AuditLog[]
  jobAlerts               JobAlert[]
  notifications           Notification[]
  followedCompanies       CompanyFollower[]
  jobViews                JobView[]
  reports                 Report[]                 @relation("Reporter")
  messageTemplates        MessageTemplate[]        @relation("TemplateAuthor")
  bulkCampaigns           BulkCampaign[]           @relation("BulkCampaignAuthor")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
  refreshTokens           RefreshToken[]
  companyInvitesSent      CompanyInvite[]          @relation("CompanyInvitesSent")
  telegramLinkTokens      TelegramLinkToken[]
  verificationsSubmitted  CompanyVerificationRequest[] @relation("VerificationSubmitter")
  verificationsReviewed   CompanyVerificationRequest[] @relation("VerificationReviewer")
  phoneLoginTokens        PhoneLoginToken[]
  linkedInConnection      LinkedInConnection?
  linkedInOAuthStates     LinkedInOAuthState[]
  linkedInPreviews        LinkedInPreview[]
  linkedInPosts           LinkedInSocialPost[]
  recruiterOnboarding    RecruiterOnboarding?
  offerPacketsCreated    ApplicationOfferPacket[] @relation("OfferPacketCreator")
  offerDocumentsUploaded ApplicationOfferDocument[] @relation("OfferDocumentUploader")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the raw token held by the client — raw token is never stored
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the raw token sent by email — raw token is never stored
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  candidateMessageBatches CandidateMessageBatch[]
  candidateImports CandidateImport[]
  recruitmentCandidates RecruitmentCandidate[]
  industryGroups BusinessIndustryGroup[] @relation("CompanyIndustryGroups")
  profileSource String @default("MANUAL")
  profileDocumentId String? @unique
  screeningDocuments AiCompanyDocument[]
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  /// Language `description` is written in; translations live in CompanyTranslation.
  locale      String       @default("uz")
  website     String?
  cityId      String?
  industryId  String?
  industryGroupId String?
  size        CompanySize?
  logoUrl     String?
  isVerified  Boolean      @default(false)
  isBanned    Boolean      @default(false)
  /// Set when the owner closes the company. The row stays for job and application history.
  anonymizedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  city             City?                @relation(fields: [cityId], references: [id])
  industry         Industry?            @relation(fields: [industryId], references: [id])
  industryGroup BusinessIndustryGroup? @relation(fields: [industryGroupId], references: [id], onDelete: Restrict)
  members          CompanyMember[]
  jobPosts         JobPost[]
  subscription     Subscription?
  payments         Payment[]
  followers        CompanyFollower[]
  messageTemplates MessageTemplate[]
  bulkCampaigns    BulkCampaign[]
  translations     CompanyTranslation[]
  invites          CompanyInvite[]
  verificationRequests CompanyVerificationRequest[]
  jobBenefits          JobBenefit[]
  candidateCredits     CandidateCredit[]
  candidateAccesses    CandidateAccess[]
  promotion            CompanyPromotion?
  supportTickets       SupportTicket[]
  linkedInPreviews      LinkedInPreview[]
  linkedInPosts         LinkedInSocialPost[]

  @@index([cityId])
  @@index([industryId])
  @@index([industryGroupId])
}

/// Request for the verified badge: legal identity plus an optional document, reviewed by an admin.
model CompanyVerificationRequest {
  id            String             @id @default(cuid())
  companyId     String
  submittedById String?
  legalName     String
  /// STIR / INN of the legal entity (9 digits for Uzbek companies).
  taxId         String             @db.VarChar(20)
  note          String?
  /// Private object key (registration certificate, licence); served via presigned URL.
  documentKey   String?
  documentName  String?
  status        VerificationStatus @default(PENDING)
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedBy User?   @relation("VerificationSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User?   @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([status])
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(RECRUITER)
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

/// Pending team invite. Raw token lives only in the email; we store SHA-256.
model CompanyInvite {
  id          String            @id @default(cuid())
  companyId   String
  email       String
  role        CompanyMemberRole
  /// Language used for the invitation email (uz/ru/en)
  locale      String            @default("uz")
  /// SHA-256 of the raw token sent by email — raw token is never stored
  tokenHash   String            @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("CompanyInvitesSent", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@index([expiresAt])
}

model Subscription {
  id        String             @id @default(cuid())
  companyId String             @unique
  plan      PlanCode           @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String        @id @default(cuid())
  companyId  String
  provider   String        @default("mock")
  externalId String?
  purpose    String
  amountUzs  Int
  currency   String        @default("UZS")
  status     PaymentStatus @default(PENDING)
  metadata   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model JobPost {
  candidateImports CandidateImport[]
  recruitmentCandidates RecruitmentCandidate[]
  positionEntryMode String @default("LEGACY")
  positionGroupId String?
  positionGroupReleaseId String?
  positionGroupScopeRevision String?
  positionGroupApprovedAt DateTime?
  positionGroup PositionGroup? @relation(fields: [positionGroupId], references: [id], onDelete: Restrict)
  positionGroupRelease PositionGroupRelease? @relation(fields: [positionGroupReleaseId], references: [id], onDelete: Restrict)
  approvedPositionMembers JobPositionGroupMember[]
  responsibilities String[] @default([])
  kpis String[] @default([])
  specificExpectations String?
  experienceRangeMin Int?
  experienceRangeMax Int?
  experienceRangeSource String?
  screeningPackages AiScreeningPackage[]
  screeningSessions AiScreeningSession[]
  id                 String           @id @default(cuid())
  companyId          String
  jobTitleId         String?
  /// Denormalized display (= JobTitle.name after resolve)
  title              String
  description        String
  cityId             String?
  /// Independent of city so country-restricted remote jobs retain their scope.
  countryId          String?
  categoryId         String?
  employmentType     EmploymentType   @default(FULL_TIME)
  workMode           WorkMode         @default(ONSITE)
  salaryMin          Int?
  salaryMax          Int?
  salaryPeriod       SalaryPeriod     @default(MONTHLY)
  currency           String           @default("UZS")
  experienceYearsMin Int?
  experienceLevel    ExperienceLevel?
  seniorityLevelCode String?
  seniorityVersion String?
  seniorityYearsMin Int?
  seniorityYearsMax Int?
  seniorityLevel SeniorityLevel? @relation(fields: [seniorityLevelCode, seniorityVersion], references: [code, version], onDelete: Restrict)
  /// Confidential posting: company hidden from candidates until INTERVIEW stage.
  isAnonymous        Boolean          @default(false)
  locale             String           @default("uz")
  status             JobStatus        @default(DRAFT)
  publishedAt        DateTime?
  closedAt           DateTime?
  boostWeight        Float            @default(0)
  boostUntil         DateTime?
  /// SHA-256 of normalized title|workMode|cityId. Never suffix with a job id.
  fingerprint        String?
  /// SHA-256 of normalized description — blocks copy-paste duplicate posts
  contentHash        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobTitle      JobTitle?            @relation(fields: [jobTitleId], references: [id])
  city          City?                @relation(fields: [cityId], references: [id])
  country       Country?             @relation(fields: [countryId], references: [id])
  category      JobCategory?         @relation(fields: [categoryId], references: [id])
  jobSkills     JobPostSkill[]
  jobLanguages  JobPostLanguage[]
  benefits      JobPostBenefit[]
  applications  Application[]
  savedBy       SavedJob[]
  questions     JobQuestion[]
  views         JobView[]
  bulkCampaigns BulkCampaign[]
  translations  JobPostTranslation[]
  benefit       JobBenefit?
  funnelSessions JobFunnelSession[]
  occupationTaskEvidence JobOccupationTaskEvidence[]
  linkedInPreviews LinkedInPreview[]
  linkedInPosts LinkedInSocialPost[]

  @@index([companyId, status])
  @@index([countryId])
  @@index([status, publishedAt])
  @@index([cityId])
  @@index([categoryId])
  @@index([jobTitleId])
  @@index([experienceLevel])
  @@index([positionGroupId, status])
  @@index([companyId, fingerprint])
  @@index([companyId, contentHash])
}

model JobOccupationTaskEvidence {
  jobId         String
  version       String
  jobUpdatedAt  DateTime
  coreKeys      String[]
  evidence      Json
  state         String @default("UNRECOGNIZED")
  recognizedClauses Int @default(0)
  unrecognizedClauses Int @default(0)
  sourceDigest  String?
  processedAt   DateTime @default(now())
  job           JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, version])
  @@index([coreKeys], type: Gin)
}

/// Optional recruiter-authored language version of a posting. The original
/// language lives on JobPost itself; `isMachine` identifies legacy AI output.
model JobPostTranslation {
  id          String   @id @default(cuid())
  jobPostId   String
  locale      String
  title       String
  description String
  isMachine   Boolean  @default(false)
  /// SHA-256 of the source text. Retained for legacy machine-generated rows.
  sourceHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, locale])
  @@index([jobPostId])
}

model JobPostLanguage {
  id         String        @id @default(cuid())
  jobPostId  String
  languageId String
  minLevel   LanguageLevel @default(B1)
  isRequired Boolean       @default(true)
  provenance String        @default("LEGACY_UNVERIFIED")

  jobPost  JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, languageId])
  @@index([languageId])
}

model JobPostSkill {
  id         String  @id @default(cuid())
  jobPostId  String
  skillId    String
  isRequired Boolean @default(true)
  weight     Float   @default(1)
  minLevel   SkillLevel?

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, skillId])
  @@index([skillId])
}

model JobPostBenefit {
  id        String @id @default(cuid())
  jobPostId String
  benefitId String

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  benefit Benefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, benefitId])
}

enum EmployeeOnboardingStatus {
  NOT_REQUIRED
  IN_PROGRESS
  COMPLETED
}

model EmployeeProfile {
  preferencesRevision Int @default(0)
  desiredGroups EmployeeDesiredGroup[]
  screeningSessions AiScreeningSession[]
  desiredRoles EmployeeDesiredRole[]
  matchingPreferencesReviewed Boolean @default(false)
  preferredWorkModes WorkMode[] @default([])
  id                String            @id @default(cuid())
  userId            String            @unique
  headline          String?
  summary           String?
  /// Detected language of the narrative fields, used to pick a translation
  /// and to badge the original when a reader is browsing in another language.
  contentLocale     String?
  cityId            String?
  phone             String?           @unique
  desiredSalaryMin  Decimal? @db.Decimal(18, 2)
  desiredSalaryCurrency String @default("UZS")
  desiredSalaryPeriod SalaryPeriod @default(MONTHLY)
  salaryNegotiable Boolean @default(false)
  desiredPositions String[] @default([])
  residenceCountryId String?
  residenceCountry Country? @relation("EmployeeResidence", fields: [residenceCountryId], references: [id], onDelete: SetNull)
  preferredCountries Country[] @relation("EmployeePreferredCountries")
  noExperience Boolean @default(false)
  onboardingStatus EmployeeOnboardingStatus @default(IN_PROGRESS)
  onboardingStep Int @default(1)
  onboardingCompletedAt DateTime?
  onboardingDraft Json?
  databaseAccesses CandidateAccess[]
  desiredPosition   String?
  /// GDPR: opt out of recruiter bulk messaging (pipeline status updates still allowed)
  bulkCommsOptOut   Boolean           @default(false)
  bulkCommsOptOutAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  city           City?                        @relation(fields: [cityId], references: [id])
  skills         ProfileSkill[]
  experiences    WorkExperience[]
  educations     Education[]
  certifications Certification[]
  languages      ProfileLanguage[]
  resumes        Resume[]
  applications   Application[]
  savedJobs      SavedJob[]
  translations   EmployeeProfileTranslation[]

  @@index([cityId])
}

model ProfileSkill {
  id        String     @id @default(cuid())
  profileId String
  skillId   String
  level     SkillLevel @default(INTERMEDIATE)
  levelSource String   @default("LEGACY_UNKNOWN")

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([skillId])
}

model WorkExperience {
  id           String    @id @default(cuid())
  profileId    String
  companyName  String
  title        String
  description  String?
  cityId       String?
  locationNote String?
  countryId String?
  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)

  profile      EmployeeProfile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  city         City?                       @relation(fields: [cityId], references: [id])
  translations WorkExperienceTranslation[]
}

model Education {
  id        String       @id @default(cuid())
  profileId String
  school    String
  degree    DegreeLevel?
  field     String?
  startDate DateTime?
  endDate   DateTime?

  profile      EmployeeProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  translations EducationTranslation[]

  @@index([school])
  @@index([degree])
}

/// Per-language version of a candidate's headline and about text.
model EmployeeProfileTranslation {
  id         String   @id @default(cuid())
  profileId  String
  locale     String
  headline   String?
  summary    String?
  isMachine  Boolean  @default(false)
  sourceHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale])
  @@index([profileId])
}

/// Per-language version of a work-experience title and description. Company names stay on the parent.
model WorkExperienceTranslation {
  id           String   @id @default(cuid())
  experienceId String
  locale       String
  title        String
  description  String?
  isMachine    Boolean  @default(false)
  sourceHash   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experience WorkExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, locale])
  @@index([experienceId])
}

/// Per-language version of an education field of study. School names stay on the parent.
model EducationTranslation {
  id          String   @id @default(cuid())
  educationId String
  locale      String
  field       String
  isMachine   Boolean  @default(false)
  sourceHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  education Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@unique([educationId, locale])
  @@index([educationId])
}

model Certification {
  id            String    @id @default(cuid())
  profileId     String
  name          String
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfileLanguage {
  id         String        @id @default(cuid())
  profileId  String
  languageId String
  level      LanguageLevel

  profile  EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([profileId, languageId])
}

model Resume {
  id               String            @id @default(cuid())
  profileId        String
  title            String
  /// Canonical target role for matching / analytics (not the free-text display title).
  targetJobTitleId String?
  content          String?
  fileKey          String?
  fileUrl          String?
  isPrimary        Boolean           @default(false)
  parsedData       Json?
  parseStatus      ResumeParseStatus @default(NONE)
  parseGeneration Int @default(0)
  parseStartedAt DateTime?
  parseError       String?
  parsedAt         DateTime?
  templateKey      String            @default("classic")
  themeAccent      String?
  inclusion        Json?
  builderMeta      Json?
  /**
   * Soft-delete tombstone; hard-purged when no Application references remain.
   */
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  currentVersionId String? @unique
  currentVersion ResumeVersion? @relation("CurrentCvVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions ResumeVersion[] @relation("CvVersions")

  profile        EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetJobTitle JobTitle?       @relation(fields: [targetJobTitleId], references: [id], onDelete: SetNull)
  applications   Application[]
  @@index([profileId])
  @@index([profileId, deletedAt])
  @@index([targetJobTitleId])
  @@index([parseStatus])
}

/// A file revision is retained independently of the editable CV library entry.
model ResumeVersion {
  screeningSource AiCvSource?
  candidatePlans AiCandidatePlan[]
  screeningSessions AiScreeningSession[]
  recruiterEvidence ResumeRecruiterEvidence[]
  employeeEvidence ResumeEmployeeEvidence?
  id String @id @default(cuid())
  resumeId String?
  fileKey String
  checksum String?
  parseStatus ResumeParseStatus @default(NONE)
  parseGeneration Int @default(0)
  parseStartedAt DateTime?
  parseError String?
  parsedAt DateTime?
  parserVersion String @default("cv-evidence-v1")
  parsedData Json?
  matchingData Json?
  skillIds String[] @default([])
  roleKeys String[] @default([])
  degreeLevels String[] @default([])
  searchText String @default("")
  experienceYears Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume Resume? @relation("CvVersions", fields: [resumeId], references: [id], onDelete: SetNull)
  currentFor Resume? @relation("CurrentCvVersion")
  applications Application[]
  @@unique([resumeId, fileKey])
  @@index([skillIds], type: Gin)
  @@index([roleKeys], type: Gin)
  @@index([degreeLevels], type: Gin)
  @@index([parseStatus])
}

model JobFamily {
  id String @id
  code String @unique
  name String
  nameId String?
  nameUz String?
  nameRu String?
  source String
  sourceVersion String
  archivedAt DateTime?
  revision Int @default(1)
  jobTitles JobTitle[]
}

/// Immutable employee profession graph releases; unrelated to HR evidence snapshots.
model OccupationRelationRelease {
  id String @id
  sourceVersion String
  algorithmVersion String
  sourceDigest String
  catalogRevision String
  report Json
  createdAt DateTime @default(now())
  profiles OccupationProfessionProfile[]
  relations OccupationProfessionRelation[]
  employeeSelection EmployeeSelectionRelease?
}

/// The existing graph pointer selects this manifest and its task evidence together.
model EmployeeSelectionRelease {
  id String @id
  graphReleaseId String @unique
  graphRelease OccupationRelationRelease @relation(fields: [graphReleaseId], references: [id], onDelete: Cascade)
  dictionaryVersion String
  taskEvidenceVersion String
  policyVersion String
  sourceDigest String
  validation Json
  createdAt DateTime @default(now())
}

model OccupationRelationState {
  id String @id @default("employee")
  activeReleaseId String?
  pinned Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model OccupationProfessionProfile {
  releaseId String
  jobTitleId String
  sourceUri String?
  mappingMethod String
  description String
  facts Json
  release OccupationRelationRelease @relation(fields:[releaseId],references:[id],onDelete:Cascade)
  @@id([releaseId, jobTitleId])
}

model OccupationProfessionRelation {
  releaseId String
  fromRoleId String
  toRoleId String
  score Float
  basis Json
  release OccupationRelationRelease @relation(fields:[releaseId],references:[id],onDelete:Cascade)
  @@id([releaseId, fromRoleId, toRoleId])
  @@index([releaseId, fromRoleId, score])
}

model OccupationRelationOverride {
  fromRoleId String
  toRoleId String
  enabled Boolean
  reason String
  actorId String
  updatedAt DateTime @updatedAt
  @@id([fromRoleId,toRoleId])
}

model EmployeeDesiredRole {
  profileId String
  jobTitleId String
  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  @@id([profileId, jobTitleId])
  @@index([jobTitleId])
}

/// Candidate search scopes; membership is never occupational equivalence.
model PositionGroup {
  id String @id
  code String @unique
  nameEn String
  definition String
  scope String
  source Json
  sourceRoleId String?
  sourceRole JobTitle? @relation(fields: [sourceRoleId], references: [id], onDelete: Restrict)
  archivedAt DateTime?
  memberships PositionGroupMembership[]
  selectedBy EmployeeDesiredGroup[]
  jobs JobPost[]
  createdAt DateTime @default(now())
}

model PositionGroupRelease {
  id String @id
  catalogRevision String
  checksum String
  algorithmVersion String
  status String @default("STAGED")
  report Json
  createdAt DateTime @default(now())
  memberships PositionGroupMembership[]
  labels PositionGroupRoleLabel[]
  states PositionGroupState[]
  jobs JobPost[]
}

model JobPositionGroupMember {
  jobId String
  jobTitleId String
  job JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  @@id([jobId, jobTitleId])
  @@index([jobTitleId, jobId])
}

model PositionGroupMembership {
  releaseId String
  groupId String
  jobTitleId String
  basis Json
  release PositionGroupRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  group PositionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  @@id([releaseId, groupId, jobTitleId])
  @@index([releaseId, jobTitleId])
}

model PositionGroupRoleLabel {
  releaseId String
  jobTitleId String
  nameEn String
  source Json
  release PositionGroupRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  @@id([releaseId, jobTitleId])
}

model PositionGroupState {
  id String @id
  activeReleaseId String?
  activeRelease PositionGroupRelease? @relation(fields: [activeReleaseId], references: [id], onDelete: Restrict)
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}

model PositionGroupCorrection {
  id String @id @default(cuid())
  groupId String
  jobTitleId String
  enabled Boolean
  reason String
  source Json
  actorId String
  createdAt DateTime @default(now())
  @@index([groupId, jobTitleId, createdAt])
}

model EmployeeDesiredGroup {
  profileId String
  groupId String
  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  group PositionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  @@id([profileId, groupId])
  @@index([groupId])
}

model ResumeEmployeeEvidence {
  versionId String @id
  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parserVersion String
  status String @default("PENDING")
  generation Int
  facts Json?
  overrides Json?
  revision Int @default(0)
  error String?
  startedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
}

model Application {
  recruitmentCandidate RecruitmentCandidate?
  screeningSession AiScreeningSession?
  hrSubmissionSnapshot Json?
  recruiterEvaluations ApplicationRecruiterEvaluation[]
  id             String            @id @default(cuid())
  jobPostId      String
  profileId      String
  resumeId       String?
  resumeVersionId String?
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  status         ApplicationStatus @default(NEW)
  kanbanEnteredAt DateTime?
  coverLetter    String?
  resumeSnapshot Json?
  funnelSessionId String?
  matchScore     Float?
  matchBreakdown Json?
  /// Acquisition source (`utm_source[:utm_medium]`, e.g. telegram:channel, pwa); null = direct.
  source         String?           @db.VarChar(40)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  jobPost    JobPost             @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  profile    EmployeeProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resume     Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  events     PipelineEvent[]
  answers    ApplicationAnswer[]
  interviews Interview[]
  offerPackets ApplicationOfferPacket[]

  @@unique([jobPostId, profileId])
  @@index([profileId])
  @@index([status])
  @@index([matchScore])
  @@index([resumeId])
  @@index([resumeVersionId])
  @@index([jobPostId, source])
  @@index([jobPostId, kanbanEnteredAt, status])
}

/// Independent HR projections: never overwrite the employee parser or submitted CV.
model ResumeRecruiterEvidence {
  id String @id @default(cuid())
  versionId String
  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parserVersion String
  catalogRevision String
  status String @default("PENDING")
  generation Int @default(0)
  revision Int @default(0)
  facts Json?
  checksum String?
  error String?
  startedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([versionId, parserVersion, catalogRevision])
  @@index([status, updatedAt])
}

model ApplicationRecruiterEvaluation {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  inputHash String
  rankingVersion String
  result Json
  createdAt DateTime @default(now())
  @@unique([applicationId, inputHash])
}

model PipelineEvent {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  actorUserId   String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

/// Immutable offer or post-hire document batch attached to one application.
model ApplicationOfferPacket {
  id          String            @id @default(cuid())
  applicationId String
  version     Int
  kind        OfferPacketKind
  status      OfferPacketStatus
  createdById String?
  note        String?           @db.VarChar(2000)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?
  revokedAt   DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("OfferPacketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents   ApplicationOfferDocument[]

  @@unique([applicationId, kind, version])
  @@index([applicationId, kind, createdAt])
  @@index([applicationId, status])
}

/// Private object-store metadata; the object key is never sent to clients.
model ApplicationOfferDocument {
  id           String   @id @default(cuid())
  packetId     String
  storageKey   String   @unique
  originalName String   @db.VarChar(255)
  contentType  String   @db.VarChar(100)
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  packet     ApplicationOfferPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  uploadedBy User?                  @relation("OfferDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([packetId, createdAt])
}

model SavedJob {
  id        String   @id @default(cuid())
  profileId String
  jobPostId String
  createdAt DateTime @default(now())

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPost JobPost         @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobPostId])
}

model Conversation {
  id             String   @id @default(cuid())
  userAId        String
  userBId        String
  companyId      String?
  jobPostId      String?
  initiatedBy    String
  isColdOutreach Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userA    User          @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User          @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([userAId, userBId, jobPostId])
  @@index([userAId])
  @@index([userBId])
}

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime  @default(now())
  /// When the peer account received/fetched the message
  deliveredAt    DateTime?
  /// When the peer account opened/read the thread
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model JobAlert {
  id              String         @id @default(cuid())
  userId          String
  name            String
  query           String?
  positionSelections Json       @default("[]")
  positionReviewRequired Boolean @default(false)
  cityId          String?
  countryId       String?
  country         Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  categoryId      String?
  frequency       AlertFrequency @default(DAILY)
  isActive        Boolean        @default(true)
  notifyInApp     Boolean        @default(true)
  notifyEmail     Boolean        @default(true)
  notifyTelegram  Boolean        @default(false)
  lastSentAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City?           @relation(fields: [cityId], references: [id])
  category JobCategory?    @relation(fields: [categoryId], references: [id])
  skills   JobAlertSkill[]

  @@index([userId])
  @@index([countryId])
}

model TelegramLinkToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 of the raw start payload — raw token is never stored
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PhoneLoginStatus {
  PENDING
  CONTACT_REQUESTED
  COMPLETED
}

/// One web sign-in attempt through the bot. The browser polls the token until
/// the bot has received the contact and resolved (or created) the account.
model PhoneLoginToken {
  role      UserRole         @default(EMPLOYEE)
  id        String           @id @default(cuid())
  /// SHA-256 of the raw start payload — raw token is never stored
  tokenHash String           @unique
  status    PhoneLoginStatus @default(PENDING)
  chatId    String?
  userId    String?
  locale    String           @default("uz")
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([expiresAt])
}

/// SMS one-time code; only issued when an SMS provider is configured.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @db.VarChar(20)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model JobAlertSkill {
  id      String @id @default(cuid())
  alertId String
  skillId String

  alert JobAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  skill Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([alertId, skillId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Enterprise features ─────────────────────────────────────

/// `messageKey` + `messageParams` let a notification follow the reader when they
/// switch language. `title`/`body` stay for rows created before that and as the
/// fallback when a key is missing from the dictionary.
model Notification {
  id            String           @id @default(cuid())
  userId        String
  type          NotificationType
  title         String
  body          String?
  messageKey    String?
  messageParams Json?
  linkUrl       String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model JobQuestion {
  id         String       @id @default(cuid())
  jobPostId  String
  question   String
  type       QuestionType @default(TEXT)
  isRequired Boolean      @default(true)
  sortOrder  Int          @default(0)

  jobPost      JobPost                 @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  answers      ApplicationAnswer[]
  translations JobQuestionTranslation[]
  revision Int @default(1)
  archivedAt DateTime?
  versions JobQuestionVersion[]

  @@index([jobPostId])
}

/// Screening question in another language. The original wording stays on
/// JobQuestion and follows the posting's locale (JobPost.locale).
model JobQuestionTranslation {
  id         String   @id @default(cuid())
  questionId String
  locale     String
  question   String
  isMachine  Boolean  @default(false)
  sourceHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobQuestion JobQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
  @@index([questionId])
}

model ApplicationAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  answer        String
  questionRevision Int?
  questionSnapshot Json?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    JobQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
}

model JobQuestionVersion {
  id String @id @default(cuid())
  questionId String
  revision Int
  snapshot Json
  createdAt DateTime @default(now())
  question JobQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([questionId, revision])
}

model PackagePolicy {
  id String @id @default(cuid())
  code JobPackageCode
  version Int
  settings Json
  createdById String?
  createdAt DateTime @default(now())
  @@unique([code, version])
}

model JobBenefit {
  id String @id @default(cuid())
  jobId String @unique
  companyId String
  code JobPackageCode @default(FREE)
  highestCode JobPackageCode @default(FREE)
  policyVersion Int @default(1)
  policySnapshot Json
  selectionConfirmedAt DateTime?
  publicationCycle Int @default(1)
  startsAt DateTime?
  expiresAt DateTime?
  candidateGranted Int @default(0)
  boostGrantedSeconds Int @default(0)
  boostAllowanceOffset Int @default(0)
  featuredGrantedSeconds Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grants JobPackageGrant[]
  boosts BoostEpisode[]
  @@index([expiresAt])
  @@index([companyId, code, expiresAt])
}

/// Each order buys one publication period for one job. No company subscription.
model JobPurchaseOrder {
  id String @id @default(cuid())
  companyId String
  jobId String?
  creationSessionId String?
  paymentRedirectUrl String?
  providerTransactionId String?
  nextReconcileAt DateTime?
  createdById String
  code JobPackageCode
  intent String
  status String @default("PENDING")
  currency String @default("IDR")
  amount Int
  catalogVersion Int
  policyVersion Int
  policySnapshot Json
  expectedBenefitVersion String?
  jobTitle String
  companyName String
  expiresAt DateTime
  paidAt DateTime?
  fulfilledAt DateTime?
  provider String?
  providerReference String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events JobPaymentEvent[]
  @@index([companyId, createdAt])
  @@index([jobId, status])
  @@index([status, expiresAt])
  @@index([status, nextReconcileAt])
}

/// Only verified provider adapters may settle an order. Raw payment credentials
/// and client-supplied "paid" statuses never enter this table.
model JobCreationSession {
  id String @id @default(cuid())
  companyId String
  createdById String
  phase String @default("PACKAGE")
  revision Int @default(0)
  draft Json @default("{}")
  orderId String? @unique
  jobId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, updatedAt])
}

model CompanyProfileDocument {
  id String @id @default(cuid())
  ownerId String
  companyId String?
  kind String @default("DOCUMENT")
  fileKey String @unique
  filename String
  contentType String
  checksum String
  sizeBytes Int
  createdAt DateTime @default(now())
  retiredAt DateTime?
  @@index([ownerId, createdAt])
  @@index([companyId])
}

model JobPaymentEvent {
  id String @id @default(cuid())
  orderId String
  provider String
  eventId String
  amount Int
  currency String
  createdAt DateTime @default(now())
  order JobPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([provider, eventId])
}

model RecruiterOnboarding {
  flowVersion Int @default(1)
  phase String @default("COMPANY")
  creationSessionId String?
  revision Int @default(0)
  userId String @id
  status String @default("IN_PROGRESS")
  step Int @default(1)
  companyId String?
  jobId String?
  companyDraft Json?
  preferredPackage JobPackageCode?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobPackageGrant {
  id String @id @default(cuid())
  benefitId String
  actorId String
  code JobPackageCode
  policyVersion Int
  reason String
  candidateDelta Int @default(0)
  boostDeltaSeconds Int @default(0)
  featuredDeltaSeconds Int @default(0)
  createdAt DateTime @default(now())
  benefit JobBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  @@index([benefitId, createdAt])
}

/// Historical entitlements are scoped to each publication period. A later Free
/// renewal must not unlock paid reports for that new period or erase old reports.
model JobPublicationPeriod {
  id String @id @default(cuid())
  jobId String
  companyId String
  cycle Int
  code JobPackageCode
  startsAt DateTime
  expiresAt DateTime
  policySnapshot Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([jobId, cycle])
  @@index([companyId, code, startsAt])
}

model CandidateCredit {
  id String @id @default(cuid())
  companyId String
  sourceKey String @unique
  jobId String?
  capacity Int
  used Int @default(0)
  startsAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accesses CandidateAccess[]
  @@index([companyId, expiresAt])
}

model CandidateAccess {
  id String @id @default(cuid())
  companyId String
  profileId String
  creditId String
  openedById String
  expiresAt DateTime
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  credit CandidateCredit @relation(fields: [creditId], references: [id], onDelete: Restrict)
  @@unique([companyId, profileId, creditId])
  @@index([companyId, profileId, expiresAt])
}

model BoostEpisode {
  id String @id @default(cuid())
  benefitId String
  startsAt DateTime
  endsAt DateTime
  createdById String
  benefit JobBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  @@index([benefitId, endsAt])
}

model CompanyPromotion {
  companyId String @id
  endsAt DateTime
  grantedSeconds Int @default(0)
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model OperationKey {
  id String @id @default(cuid())
  scope String
  key String
  payloadHash String
  state String @default("RUNNING")
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([scope, key])
}

model ContactRevealCounter {
  actorId String
  windowStart DateTime
  count Int @default(0)
  @@id([actorId, windowStart])
}

model JobFunnelSession {
  id String @id @default(cuid())
  jobId String
  sessionKey String @unique
  visitorHash String
  source String @default("direct")
  startedAt DateTime @default(now())
  expiresAt DateTime
  job JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  events JobEvent[]
  @@index([jobId, startedAt])
}

model JobEvent {
  id String @id @default(cuid())
  sessionId String
  kind JobEventKind
  applicationId String? @unique
  createdAt DateTime @default(now())
  session JobFunnelSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, kind])
  @@index([createdAt])
}

model SupportTicket {
  id String @id @default(cuid())
  companyId String
  jobId String?
  createdById String
  assignedToId String?
  title String
  priority Boolean @default(false)
  status SupportTicketStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  replies SupportReply[]
  @@index([companyId, createdAt])
  @@index([status, priority, createdAt])
}

model SupportReply {
  id String @id @default(cuid())
  ticketId String
  authorId String
  authorRole UserRole
  body String
  createdAt DateTime @default(now())
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model Interview {
  recruitmentInterview CandidateInterview?
  id            String          @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  durationMins  Int             @default(60)
  location      String?
  meetingUrl    String?
  note          String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
}

model CompanyFollower {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model JobView {
  id        String   @id @default(cuid())
  jobPostId String
  viewerId  String?
  createdAt DateTime @default(now())

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  viewer  User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([jobPostId, createdAt])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  entityType ReportEntityType
  entityId   String
  reason     String
  status     ReportStatus     @default(OPEN)
  resolution String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([entityType, entityId])
}

// ─── Bulk communication (recruiter) ──────────────────────────

model MessageTemplate {
  id        String   @id @default(cuid())
  companyId String
  createdBy String
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author    User           @relation("TemplateAuthor", fields: [createdBy], references: [id], onDelete: Cascade)
  campaigns BulkCampaign[]

  @@index([companyId, updatedAt])
}

model BulkCampaign {
  id          String             @id @default(cuid())
  companyId   String
  jobPostId   String
  createdById String
  templateId  String?
  messageBody String?
  fromStatus  ApplicationStatus?
  toStatus    ApplicationStatus?
  note        String?
  createdAt   DateTime           @default(now())

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPost    JobPost                 @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  createdBy  User                    @relation("BulkCampaignAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  template   MessageTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients BulkCampaignRecipient[]

  @@index([companyId, createdAt])
  @@index([jobPostId, createdAt])
}

model BulkCampaignRecipient {
  id             String             @id @default(cuid())
  campaignId     String
  applicationId  String
  userId         String
  candidateName  String
  deliveryStatus BulkDeliveryStatus @default(PENDING)
  errorMessage   String?
  conversationId String?
  messageId      String?
  statusMoved    Boolean            @default(false)
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  campaign BulkCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId, createdAt])
  @@index([applicationId])
}

enum NewsCategory {
  CAREER
  INSIGHT
  EVENT
  EDUCATION
}

/// Curated editorial content (career/insight/event/education). Seeded with
/// original summaries plus source attribution - not scraped article bodies.
model NewsArticle {
  id          String       @id @default(cuid())
  slug        String       @unique
  category    NewsCategory
  title       String
  excerpt     String
  /// Plain paragraphs separated by blank lines (rendered as <p> blocks)
  body        String
  coverUrl    String?
  coverCredit String?
  sourceName  String?
  sourceUrl   String?
  locale      String       @default("en")
  publishedAt DateTime
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  translations NewsArticleTranslation[]

  @@index([isPublished, publishedAt])
  @@index([category, publishedAt])
}

/// Per-language version of an article. The slug stays shared so one canonical
/// URL per article keeps its search ranking across languages.
model NewsArticleTranslation {
  id         String   @id @default(cuid())
  articleId  String
  locale     String
  title      String
  excerpt    String
  body       String
  isMachine  Boolean  @default(false)
  sourceHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([articleId])
}

/// Optional localized company description.
model CompanyTranslation {
  id          String   @id @default(cuid())
  companyId   String
  locale      String
  description String
  isMachine   Boolean  @default(false)
  sourceHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, locale])
  @@index([companyId])
}


model CandidateImport {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId String?
  job JobPost? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  requestKey String
  createdById String
  createdAt DateTime @default(now())
  candidates RecruitmentCandidate[]
  @@unique([companyId, requestKey])
  @@index([companyId, createdAt])
}

model RecruitmentCandidate {
  interviews CandidateInterview[]
  messages CandidateMessage[]
  invitations ScreeningInvitation[]
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId String?
  job JobPost? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId String? @unique
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  importId String?
  import CandidateImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  importFileId String?
  dedupeKey String? @unique
  filename String
  contentType String
  sizeBytes Int
  uploadKey String?
  fileKey String?
  checksum String?
  fullName String
  email String?
  phone String?
  headline String @default("")
  stage ApplicationStatus @default(NEW)
  enteredProcessAt DateTime?
  assignedToId String?
  assignedTo User? @relation("CandidateAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  scoreStatus String @default("UPLOADING")
  cvScore Float?
  cvResult Json?
  jobSnapshot Json?
  scoringVersion String?
  error String?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activities CandidateActivity[]
  @@unique([importId, importFileId])
  @@index([companyId, jobId, stage])
  @@index([companyId, scoreStatus, createdAt])
  @@index([jobId, cvScore, createdAt])
}

model CandidateActivity {
  id String @id @default(cuid())
  candidateId String
  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actorUserId String?
  kind String
  detail Json?
  createdAt DateTime @default(now())
  @@index([candidateId, createdAt])
}

model ScreeningInvitation {
  packageId String
  package AiScreeningPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  id String @id @default(cuid())
  candidateId String
  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  mode String
  recipientEmail String
  createdById String?
  createdBy User? @relation("ScreeningSender", fields: [createdById], references: [id], onDelete: SetNull)
  claimedUserId String?
  claimedUser User? @relation("ScreeningRecipient", fields: [claimedUserId], references: [id], onDelete: SetNull)
  requestKey String
  tokenNonce String
  tokenHash String @unique
  expiresAt DateTime
  status String @default("INVITED")
  snapshot Json
  sessionId String? @unique
  session AiScreeningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  emailStatus String @default("PENDING")
  emailAttemptAt DateTime?
  emailSentAt DateTime?
  messageStatus String @default("PENDING")
  messageId String? @unique
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([candidateId, requestKey])
  @@index([candidateId, createdAt])
  @@index([claimedUserId, status])
  @@index([status, expiresAt])
}


model VoiceInterview {
  taraInterview Json?
  id String @id @default(cuid())
  sessionId String? @unique
  session AiScreeningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  status String @default("CREATING")
  providerId String? @unique
  model String
  promptVersion String
  promptSnapshot Json
  startedAt DateTime @default(now())
  heartbeatAt DateTime @default(now())
  warningAt DateTime?
  closingAt DateTime?
  endedAt DateTime?
  closeReason String?
  owner String
  leaseUntil DateTime
  transcriptComplete Boolean @default(false)
  usage Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fragments VoiceFragment[]
  @@index([status, leaseUntil])
}
model VoiceFragment {
  id Int @id @default(autoincrement())
  voiceId String
  voice VoiceInterview @relation(fields: [voiceId], references: [id], onDelete: Cascade)
  eventId String
  speaker String
  text String
  startMs Int
  endMs Int
  receivedAt DateTime @default(now())
  @@unique([voiceId, eventId])
  @@index([voiceId, id])
}


model CandidateMessageBatch {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy User? @relation("CandidateMessageAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  requestKey String
  inputHash String
  subject String
  bodyTemplate String
  email Boolean @default(true)
  talentio Boolean @default(true)
  createdAt DateTime @default(now())
  messages CandidateMessage[]
  @@unique([companyId, requestKey])
  @@index([companyId, createdAt])
}

model CandidateMessage {
  id String @id @default(cuid())
  batchId String
  batch CandidateMessageBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  candidateId String
  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewId String?
  interview CandidateInterview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  interviewRevision Int?
  recipientEmail String
  recipientUserId String?
  subject String
  body String
  kind String @default("MESSAGE")
  emailStatus String @default("PENDING")
  emailAttemptAt DateTime?
  emailSentAt DateTime?
  messageStatus String @default("PENDING")
  messageId String? @unique
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([batchId, candidateId])
  @@index([candidateId, createdAt])
  @@index([messageStatus, createdAt])
}

model CandidateInterview {
  id String @id @default(cuid())
  candidateId String
  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  nativeInterviewId String? @unique
  nativeInterview Interview? @relation(fields: [nativeInterviewId], references: [id], onDelete: Cascade)
  requestKey String
  createdById String?
  scheduledAt DateTime
  durationMins Int @default(30)
  location String?
  meetingUrl String?
  note String?
  status InterviewStatus @default(SCHEDULED)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages CandidateMessage[]
  @@unique([candidateId, requestKey])
  @@index([candidateId, status, scheduledAt])
}

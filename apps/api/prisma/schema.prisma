generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  RECRUITER
  SUPER_ADMIN
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER
}

enum PlanCode {
  FREE
  STANDARD
  PREMIUM
  VIP
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  EXPIRED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  NEW
  IN_REVIEW
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ProfileVisibility {
  PUBLIC
  TO_REGISTERED_RECRUITERS
  PRIVATE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

enum AlertFrequency {
  DAILY
  WEEKLY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  MOCKED
}

enum DegreeLevel {
  HIGH_SCHOOL
  VOCATIONAL
  BACHELOR
  MASTER
  PHD
}

enum ExperienceLevel {
  INTERN
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
  EXECUTIVE
}

enum SalaryPeriod {
  MONTHLY
  YEARLY
  HOURLY
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1000_PLUS
}

enum NotificationType {
  APPLICATION_STATUS
  NEW_APPLICANT
  INTERVIEW_SCHEDULED
  NEW_JOB_MATCH
  CHAT_MESSAGE
  SYSTEM
}

enum QuestionType {
  TEXT
  YES_NO
  NUMBER
}

enum BulkDeliveryStatus {
  PENDING
  SENT
  SKIPPED_OPTED_OUT
  FAILED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReportEntityType {
  JOB_POST
  USER
  COMPANY
  CHAT_MESSAGE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ProvinceType {
  REGION
  CITY
  REPUBLIC
}

// ─── Lookup tables ───────────────────────────────────────────

model Skill {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  normalizedKey  String?  @unique
  category       String?
  createdAt      DateTime @default(now())

  aliases        SkillAlias[]
  profileSkills  ProfileSkill[]
  jobPostSkills  JobPostSkill[]
  jobAlertSkills JobAlertSkill[]
}

model SkillAlias {
  id        String   @id @default(cuid())
  skillId   String
  alias     String
  aliasKey  String   @unique
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model Country {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  iso2         String   @unique @db.Char(2)
  iso3         String   @db.Char(3)
  phoneCode    String
  currencyCode String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provinces Province[]
}

model Province {
  id        String       @id @default(cuid())
  countryId String
  name      String
  slug      String
  type      ProvinceType @default(REGION)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities  City[]

  @@unique([countryId, slug])
  @@index([countryId])
}

model City {
  id         String @id @default(cuid())
  name       String
  slug       String @unique
  provinceId String

  province        Province          @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  jobPosts        JobPost[]
  profiles        EmployeeProfile[]
  companies       Company[]
  jobAlerts       JobAlert[]
  workExperiences WorkExperience[]

  @@index([provinceId])
}

model JobCategory {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  icon String?

  jobPosts  JobPost[]
  jobAlerts JobAlert[]
}

model IndustryGroup {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  sortOrder Int    @default(0)

  industries Industry[]
}

model Industry {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  sortOrder Int    @default(0)
  groupId   String

  group     IndustryGroup @relation(fields: [groupId], references: [id])
  companies Company[]

  @@index([groupId])
}

model Language {
  id            String  @id @default(cuid())
  name          String
  code          String  @unique
  normalizedKey String? @unique

  aliases          LanguageAlias[]
  profileLanguages ProfileLanguage[]
  jobLanguages     JobPostLanguage[]
}

model LanguageAlias {
  id         String   @id @default(cuid())
  languageId String
  alias      String
  aliasKey   String   @unique
  createdAt  DateTime @default(now())

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@index([languageId])
}

model Benefit {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  normalizedKey String? @unique
  icon          String?

  aliases         BenefitAlias[]
  jobPostBenefits JobPostBenefit[]
}

model BenefitAlias {
  id        String   @id @default(cuid())
  benefitId String
  alias     String
  aliasKey  String   @unique
  createdAt DateTime @default(now())

  benefit Benefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@index([benefitId])
}

/// Canonical role title (no seniority — use JobPost.experienceLevel).
model JobTitle {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  normalizedKey String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases  JobTitleAlias[]
  jobPosts JobPost[]
  resumes  Resume[]
}

model JobTitleAlias {
  id         String   @id @default(cuid())
  jobTitleId String
  alias      String
  aliasKey   String   @unique
  createdAt  DateTime @default(now())

  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)

  @@index([jobTitleId])
}

// ─── Core identity ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  fullName      String
  role          UserRole  @default(EMPLOYEE)
  locale        String    @default("uz")
  avatarUrl     String?
  isBanned      Boolean   @default(false)
  emailVerified Boolean   @default(false)
  googleId      String?   @unique
  telegramId    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employeeProfile  EmployeeProfile?
  memberships      CompanyMember[]
  sentMessages     ChatMessage[]       @relation("SentMessages")
  conversationsAsA Conversation[]      @relation("ConversationUserA")
  conversationsAsB Conversation[]      @relation("ConversationUserB")
  auditLogs        AuditLog[]
  jobAlerts        JobAlert[]
  notifications    Notification[]
  followedCompanies CompanyFollower[]
  jobViews         JobView[]
  reports          Report[]            @relation("Reporter")
  messageTemplates MessageTemplate[]   @relation("TemplateAuthor")
  bulkCampaigns    BulkCampaign[]      @relation("BulkCampaignAuthor")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the raw token sent by email — raw token is never stored
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  website     String?
  cityId      String?
  industryId  String?
  size        CompanySize?
  logoUrl     String?
  isVerified  Boolean      @default(false)
  isBanned    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  city         City?             @relation(fields: [cityId], references: [id])
  industry     Industry?         @relation(fields: [industryId], references: [id])
  members          CompanyMember[]
  jobPosts         JobPost[]
  subscription     Subscription?
  payments         Payment[]
  followers        CompanyFollower[]
  messageTemplates MessageTemplate[]
  bulkCampaigns    BulkCampaign[]

  @@index([cityId])
  @@index([industryId])
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(RECRUITER)
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model Subscription {
  id        String             @id @default(cuid())
  companyId String             @unique
  plan      PlanCode           @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String        @id @default(cuid())
  companyId  String
  provider   String        @default("mock")
  externalId String?
  purpose    String
  amountUzs  Int
  currency   String        @default("UZS")
  status     PaymentStatus @default(PENDING)
  metadata   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model JobPost {
  id                 String          @id @default(cuid())
  companyId          String
  jobTitleId         String?
  /// Denormalized display (= JobTitle.name after resolve)
  title              String
  description        String
  cityId             String?
  categoryId         String?
  employmentType     EmploymentType  @default(FULL_TIME)
  workMode           WorkMode        @default(ONSITE)
  salaryMin          Int?
  salaryMax          Int?
  salaryPeriod       SalaryPeriod    @default(MONTHLY)
  currency           String          @default("UZS")
  experienceYearsMin Int?
  experienceLevel    ExperienceLevel?
  locale             String          @default("uz")
  status             JobStatus       @default(DRAFT)
  publishedAt        DateTime?
  closedAt           DateTime?
  boostWeight        Float           @default(0)
  boostUntil         DateTime?
  /// SHA-256 of normalized title|workMode|cityId — blocks duplicate openings
  fingerprint        String?
  /// SHA-256 of normalized description — blocks copy-paste duplicate posts
  contentHash        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobTitle     JobTitle?        @relation(fields: [jobTitleId], references: [id])
  city         City?            @relation(fields: [cityId], references: [id])
  category     JobCategory?     @relation(fields: [categoryId], references: [id])
  jobSkills     JobPostSkill[]
  jobLanguages  JobPostLanguage[]
  benefits      JobPostBenefit[]
  applications  Application[]
  savedBy       SavedJob[]
  questions     JobQuestion[]
  views         JobView[]
  bulkCampaigns BulkCampaign[]

  @@index([companyId, status])
  @@index([status, publishedAt])
  @@index([cityId])
  @@index([categoryId])
  @@index([jobTitleId])
  @@index([experienceLevel])
  @@index([companyId, fingerprint])
  @@index([companyId, contentHash])
}

model JobPostLanguage {
  id         String        @id @default(cuid())
  jobPostId  String
  languageId String
  minLevel   LanguageLevel @default(B1)
  isRequired Boolean       @default(true)

  jobPost  JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, languageId])
  @@index([languageId])
}

model JobPostSkill {
  id        String  @id @default(cuid())
  jobPostId String
  skillId   String
  isRequired Boolean @default(true)
  weight    Float   @default(1)

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, skillId])
  @@index([skillId])
}

model JobPostBenefit {
  id        String @id @default(cuid())
  jobPostId String
  benefitId String

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  benefit Benefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, benefitId])
}

model EmployeeProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  headline         String?
  summary          String?
  cityId           String?
  phone            String?           @unique
  visibility          ProfileVisibility @default(TO_REGISTERED_RECRUITERS)
  desiredSalaryMin    Int?
  desiredPosition     String?
  /// GDPR: opt out of recruiter bulk messaging (pipeline status updates still allowed)
  bulkCommsOptOut     Boolean           @default(false)
  bulkCommsOptOutAt   DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  city           City?             @relation(fields: [cityId], references: [id])
  skills         ProfileSkill[]
  experiences    WorkExperience[]
  educations     Education[]
  certifications Certification[]
  languages      ProfileLanguage[]
  resumes        Resume[]
  applications   Application[]
  savedJobs      SavedJob[]

  @@index([cityId])
}

model ProfileSkill {
  id        String     @id @default(cuid())
  profileId String
  skillId   String
  level     SkillLevel @default(INTERMEDIATE)

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([skillId])
}

model WorkExperience {
  id           String    @id @default(cuid())
  profileId    String
  companyName  String
  title        String
  description  String?
  cityId       String?
  locationNote String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  city    City?           @relation(fields: [cityId], references: [id])
}

model Education {
  id        String       @id @default(cuid())
  profileId String
  school    String
  degree    DegreeLevel?
  field     String?
  startDate DateTime?
  endDate   DateTime?

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([school])
  @@index([degree])
}

model Certification {
  id            String    @id @default(cuid())
  profileId     String
  name          String
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfileLanguage {
  id         String        @id @default(cuid())
  profileId  String
  languageId String
  level      LanguageLevel

  profile  EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([profileId, languageId])
}

model Resume {
  id                String    @id @default(cuid())
  profileId         String
  title             String
  /// Canonical target role for matching / analytics (not the free-text display title).
  targetJobTitleId  String?
  content           String?
  fileKey           String?
  fileUrl           String?
  isPrimary         Boolean   @default(false)
  parsedData        Json?
  templateKey       String    @default("classic")
  themeAccent       String?
  inclusion         Json?
  builderMeta       Json?
  /** Soft-delete tombstone; hard-purged when no Application references remain. */
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile         EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetJobTitle  JobTitle?       @relation(fields: [targetJobTitleId], references: [id], onDelete: SetNull)
  applications    Application[]

  @@index([profileId])
  @@index([profileId, deletedAt])
  @@index([targetJobTitleId])
}

model Application {
  id             String            @id @default(cuid())
  jobPostId      String
  profileId      String
  resumeId       String?
  status         ApplicationStatus @default(NEW)
  coverLetter    String?
  resumeSnapshot Json?
  matchScore     Float?
  matchBreakdown Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  jobPost   JobPost             @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  profile   EmployeeProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resume    Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  events    PipelineEvent[]
  answers   ApplicationAnswer[]
  interviews Interview[]

  @@unique([jobPostId, profileId])
  @@index([profileId])
  @@index([status])
  @@index([matchScore])
  @@index([resumeId])
}

model PipelineEvent {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  actorUserId   String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model SavedJob {
  id        String   @id @default(cuid())
  profileId String
  jobPostId String
  createdAt DateTime @default(now())

  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPost JobPost         @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobPostId])
}

model Conversation {
  id             String   @id @default(cuid())
  userAId        String
  userBId        String
  companyId      String?
  jobPostId      String?
  initiatedBy    String
  isColdOutreach Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userA    User          @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User          @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([userAId, userBId, jobPostId])
  @@index([userAId])
  @@index([userBId])
}

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime  @default(now())
  /// When the peer account received/fetched the message
  deliveredAt    DateTime?
  /// When the peer account opened/read the thread
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model JobAlert {
  id         String         @id @default(cuid())
  userId     String
  name       String
  query      String?
  cityId     String?
  categoryId String?
  frequency  AlertFrequency @default(DAILY)
  isActive   Boolean        @default(true)
  lastSentAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City?           @relation(fields: [cityId], references: [id])
  category JobCategory?    @relation(fields: [categoryId], references: [id])
  skills   JobAlertSkill[]

  @@index([userId])
}

model JobAlertSkill {
  id      String @id @default(cuid())
  alertId String
  skillId String

  alert JobAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  skill Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([alertId, skillId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Enterprise features ─────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model JobQuestion {
  id         String       @id @default(cuid())
  jobPostId  String
  question   String
  type       QuestionType @default(TEXT)
  isRequired Boolean      @default(true)
  sortOrder  Int          @default(0)

  jobPost JobPost             @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  answers ApplicationAnswer[]

  @@index([jobPostId])
}

model ApplicationAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  answer        String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    JobQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  durationMins  Int             @default(60)
  location      String?
  meetingUrl    String?
  note          String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
}

model CompanyFollower {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model JobView {
  id        String   @id @default(cuid())
  jobPostId String
  viewerId  String?
  createdAt DateTime @default(now())

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  viewer  User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([jobPostId, createdAt])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  entityType ReportEntityType
  entityId   String
  reason     String
  status     ReportStatus     @default(OPEN)
  resolution String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([entityType, entityId])
}

// ─── Bulk communication (recruiter) ──────────────────────────

model MessageTemplate {
  id        String   @id @default(cuid())
  companyId String
  createdBy String
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author    User           @relation("TemplateAuthor", fields: [createdBy], references: [id], onDelete: Cascade)
  campaigns BulkCampaign[]

  @@index([companyId, updatedAt])
}

model BulkCampaign {
  id          String             @id @default(cuid())
  companyId   String
  jobPostId   String
  createdById String
  templateId  String?
  messageBody String?
  fromStatus  ApplicationStatus?
  toStatus    ApplicationStatus?
  note        String?
  createdAt   DateTime           @default(now())

  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPost    JobPost                  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  createdBy  User                     @relation("BulkCampaignAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  template   MessageTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients BulkCampaignRecipient[]

  @@index([companyId, createdAt])
  @@index([jobPostId, createdAt])
}

model BulkCampaignRecipient {
  id             String             @id @default(cuid())
  campaignId     String
  applicationId  String
  userId         String
  candidateName  String
  deliveryStatus BulkDeliveryStatus @default(PENDING)
  errorMessage   String?
  conversationId String?
  messageId      String?
  statusMoved    Boolean            @default(false)
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  campaign BulkCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId, createdAt])
  @@index([applicationId])
}

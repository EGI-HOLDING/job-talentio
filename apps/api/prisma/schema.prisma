generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiCompanyDocument {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileKey String
  filename String
  contentType String
  checksum String
  status String @default("PENDING")
  text String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, createdAt])
}

model AiScreeningPackage {
  invitations ScreeningInvitation[]
  id String @id @default(cuid())
  jobId String
  job JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fingerprint String
  version Int
  status String @default("PENDING")
  jobSnapshot Json
  companySnapshot Json
  promptVersion String
  promptSnapshot Json
  conversationPolicy Json?
  payload Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions AiScreeningSession[]
  candidatePlans AiCandidatePlan[]
  @@unique([jobId, fingerprint])
  @@unique([jobId, version])
  @@index([status, updatedAt])
}

model AiScreeningSession {
  taraInterview Json?
  taraDeadlineAt DateTime?
  taraAdvanceAt DateTime?
  voice VoiceInterview?
  id String @id @default(cuid())
  legacyKey String? @unique
  invitation ScreeningInvitation?
  jobId String
  job JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profileId String
  profile EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  packageId String?
  package AiScreeningPackage? @relation(fields: [packageId], references: [id])
  resumeId String?
  resumeVersionId String?
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  cvSnapshot Json?
  currentPlanId String? @unique
  currentPlan AiCandidatePlan? @relation("CurrentScreeningPlan", fields: [currentPlanId], references: [id], onDelete: SetNull)
  plans AiCandidatePlan[] @relation("SessionScreeningPlans")
  coverLetter String?
  coverFileKey String?
  coverFilename String?
  coverContentType String?
  source String?
  funnelSession String?
  status String @default("DRAFT")
  revision Int @default(0)
  leaseToken String?
  leaseExpiresAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  applicationId String? @unique
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions AiScreeningQuestion[]
  evaluation AiScreeningEvaluation?
  @@index([jobId, profileId])
  @@index([status, updatedAt])
  @@index([taraDeadlineAt, status])
  @@index([taraAdvanceAt, status])
}

model AiScreeningQuestion {
  id String @id @default(cuid())
  sessionId String
  session AiScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position Int
  criterionId String
  claimId String
  rootQuestionId String?
  parentQuestionId String?
  depth Int @default(0)
  probeClosed Boolean @default(false)
  kind String
  text String
  draft String @default("")
  answer String?
  shownAt DateTime?
  deadlineAt DateTime?
  answeredAt DateTime?
  timedOut Boolean @default(false)
  @@unique([sessionId, position])
}

model AiCvSource {
  versionId String @id
  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  checksum String
  status String @default("PENDING")
  text String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiCandidatePlan {
  id String @id @default(cuid())
  sessionId String
  session AiScreeningSession @relation("SessionScreeningPlans", fields: [sessionId], references: [id], onDelete: Cascade)
  currentFor AiScreeningSession? @relation("CurrentScreeningPlan")
  packageId String
  package AiScreeningPackage @relation(fields: [packageId], references: [id])
  resumeVersionId String
  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  fingerprint String
  status String @default("PENDING")
  promptVersion String
  payload Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sessionId, fingerprint])
  @@index([status, updatedAt])
}

model AiScreeningEvaluation {
  id String @id @default(cuid())
  sessionId String @unique
  session AiScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status String @default("PENDING")
  inputHash String?
  promptVersion String
  model String?
  cvScore Float?
  cvBreakdown Json?
  screeningScore Float?
  finalScore Float?
  result Json?
  pdfKey String?
  pdfVersion String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions AiScreeningEvaluationRevision[]
  @@index([status, updatedAt])
}

/// Immutable assessment history. Current evaluation is promoted only after validation.
model AiScreeningEvaluationRevision {
  id String @id @default(cuid())
  evaluationId String
  evaluation AiScreeningEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  inputHash String
  promptVersion String
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([evaluationId, inputHash])
}

/// Durable outbox; Redis is a delivery mechanism, never the source of truth.
model AiScreeningWork {
  id String @id @default(cuid())
  key String @unique
  kind String
  subjectId String
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseOwner String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, availableAt])
}

model AiScreeningCall {
  id String @id @default(cuid())
  key String @unique
  workId String
  task String
  subjectId String
  model String
  promptVersion String
  inputHash String
  status String @default("PENDING")
  responseId String?
  result Json?
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  cachedTokens Int @default(0)
  reasoningTokens Int @default(0)
  usage Json?
  costUsd Float @default(0)
  pricing Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([subjectId, createdAt])
  @@index([status, updatedAt])
}

enum LinkedInConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum LinkedInPostStatus {
  PENDING
  RENDERING
  UPLOADING
  PUBLISHING
  PUBLISHED
  FAILED
  UNKNOWN
  CANCELLED
}

// A personal consent belongs to its HR user, never to everyone in a company.
model LinkedInConnection {
  id              String @id @default(cuid())
  userId          String @unique
  subject         String?
  authorUrn       String?
  displayName     String?
  avatarUrl       String?
  grantedScopes   String[] @default([])
  tokenCiphertext String?
  tokenKeyVersion String?
  tokenExpiresAt  DateTime?
  status          LinkedInConnectionStatus @default(DISCONNECTED)
  autoShareEnabled Boolean @default(false)
  generation      Int @default(0)
  leaseOwner      String?
  leaseUntil      DateTime?
  connectedAt     DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  previews        LinkedInPreview[]
  posts           LinkedInSocialPost[]
}

model LinkedInOAuthState {
  stateHash      String @id
  userId         String
  cookieHash     String
  sessionVersion Int
  returnTo       String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Server-created preview: exactly these bytes and caption may be approved.
model LinkedInPreview {
  id                   String @id @default(cuid())
  userId               String
  companyId            String
  jobId                String
  connectionId         String
  connectionGeneration Int
  locale               String
  fingerprint          String
  content              Json
  caption              String
  jobUrl               String
  posterKey            String
  posterSha256         String
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company              Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job                  JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  connection           LinkedInConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  posts                LinkedInSocialPost[]
  @@index([userId, jobId])
  @@index([expiresAt])
}

model LinkedInSocialPost {
  id                   String @id @default(cuid())
  userId               String
  companyId            String
  jobId                String
  connectionId         String
  connectionGeneration Int
  publicationRevision  Int @default(1)
  previewId            String?
  authorUrnSnapshot    String
  content              Json
  captionSnapshot      String
  jobUrlSnapshot       String
  posterKey            String
  posterSha256         String
  imageUrn             String?
  providerPostUrn      String?
  status               LinkedInPostStatus @default(PENDING)
  attempts             Int @default(0)
  attemptId            String?
  leaseUntil           DateTime?
  nextAttemptAt        DateTime @default(now())
  retrySafe            Boolean @default(true)
  errorCode            String?
  errorSummary         String?
  publishedAt          DateTime?
  reconciledAt         DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company              Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job                  JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)
  connection           LinkedInConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  preview              LinkedInPreview? @relation(fields: [previewId], references: [id], onDelete: SetNull)
  outbox               LinkedInOutbox?
  @@unique([jobId, userId, publicationRevision])
  @@index([userId, companyId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@index([authorUrnSnapshot, status, leaseUntil])
}

// Redis delivery is acknowledged only when a worker claims the DB record.
model LinkedInOutbox {
  id             String @id @default(cuid())
  socialPostId   String @unique
  nextDispatchAt DateTime @default(now())
  processedAt    DateTime?
  attempts       Int @default(0)
  createdAt      DateTime @default(now())
  post           LinkedInSocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  @@index([processedAt, nextDispatchAt])
}

